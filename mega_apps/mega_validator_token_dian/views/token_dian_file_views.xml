<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM -->
    <record id="view_mega_dian_token_file_form" model="ir.ui.view">
        <field name="name">mega.dian.token.file.form</field>
        <field name="model">mega.dian.token.file</field>
        <field name="arch" type="xml">
            <form string="Archivo del Token DIAN" create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="tipo_documento"/>
                            <field name="folio"/>
                            <field name="prefijo"/>
                            <field name="nit_emisor"/>
                            <field name="nombre_emisor"/>
                        </group>
                        <group>
                            <field name="iva"/>
                            <field name="total" string="Total Dian"/>
                            <field name="is_reconciled" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_mega_dian_token_file_list" model="ir.ui.view">
        <field name="name">mega.dian.token.file.list</field>
        <field name="model">mega.dian.token.file</field>
        <field name="arch" type="xml">
            <list string="Archivos del Token DIAN" create="0" delete="0" edit="0">
                <field name="tipo_documento"/>
                <field name="folio"/>
                <field name="prefijo" optional="hide"/>
                <field name="nit_emisor" optional="show"/>
                <field name="nombre_emisor" optional="hide"/>
                <field name="iva" optional="show"/>
                <field name="total" string="Total Dian" optional="show"/>
                <field name="fecha_emision_dian" string="Fecha emisión DIAN" optional="show"/>

                <field name="partner_id" optional="hide"/>
                <field name="move_id" optional="show"/>
                <field name="odoo_ref" optional="show"/>
                <field name="odoo_iva" optional="show"/>
                <field name="odoo_total" optional="show"/>
                <field name="validation_status" optional="show"/>
                <field name="validation_note" optional="show"/>
                <field name="fecha_factura_odoo" string="Fecha factura Odoo" optional="show"/>
                <field name="is_reconciled" widget="boolean_toggle" optional="show"/>

            </list>
        </field>
    </record>

</odoo>
