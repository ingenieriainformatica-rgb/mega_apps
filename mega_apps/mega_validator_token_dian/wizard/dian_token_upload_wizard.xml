<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mega_dian_token_upload_wizard_form" model="ir.ui.view">
        <field name="name">mega.dian.token.upload.wizard.form</field>
        <field name="model">mega.dian.token.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Subir archivo DIAN">
                <group>
                    <field name="token_id" invisible="1"/>
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar archivo" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
