<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_move_form_name_group_editable" model="ir.ui.view">
    <field name="name">account.move.form.name.group.editable</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="priority">999</field>
    <field name="arch" type="xml">

      <xpath expr="//div[@class='oe_title']/h1/field[@name='name']" position="replace">

        <!-- Grupo: editable SIEMPRE -->
        <field name="name"
               groups="mega_account_block_sequence_group.group_edit_move_sequence_gruops"
               invisible="not (name or name_placeholder or quick_edit_mode)"
               readonly="0"
               options="{'placeholder_field': 'name_placeholder'}"
               force_save="1"/>

        <!-- Resto: readonly SIEMPRE -->
        <field name="name"
               groups="!mega_account_block_sequence_group.group_edit_move_sequence_gruops"
               invisible="not (name or name_placeholder or quick_edit_mode)"
               readonly="1"
               options="{'placeholder_field': 'name_placeholder'}"
               force_save="1"/>

      </xpath>

    </field>
  </record>
</odoo>
