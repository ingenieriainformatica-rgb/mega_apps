<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_test_queue_job_demo_list" model="ir.ui.view">
        <field name="name">test.queue.job.demo.list</field>
        <field name="model">test.queue.job.demo</field>
        <field name="arch" type="xml">
            <list string="Test Queue Job Demo">
                <field name="name"/>
                <field name="state"/>
                <field name="requested_at"/>
                <field name="eta_at"/>
                <field name="executed_at"/>
                <field name="job_uuid"/>
            </list>
        </field>
    </record>

    <record id="view_test_queue_job_demo_form" model="ir.ui.view">
        <field name="name">test.queue.job.demo.form</field>
        <field name="model">test.queue.job.demo</field>
        <field name="arch" type="xml">
            <form string="Test Queue Job Demo">
                <header>
                    <button name="action_enqueue_demo_job"
                            type="object"
                            string="Ejecutar Job 10 segundos"
                            class="btn-primary"
                            invisible="state == 'queued'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="job_uuid" readonly="1"/>
                    </group>
                    <group>
                        <field name="requested_at" readonly="1"/>
                        <field name="eta_at" readonly="1"/>
                        <field name="executed_at" readonly="1"/>
                    </group>
                    <group>
                        <field name="result_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_test_queue_job_demo" model="ir.actions.act_window">
        <field name="name">Test Queue Job Demo</field>
        <field name="res_model">test.queue.job.demo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_test_queue_job_demo"
              name="Test Queue Job Demo"
              parent="base.menu_administration"
              action="action_test_queue_job_demo"
              groups="base.group_system"
              sequence="990"/>
</odoo>
