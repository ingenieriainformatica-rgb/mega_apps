<templates xml:space="preserve">

  <t t-name="mega_dashboard.KpiCards">
    <section class="container-fluid px-3 px-lg-4 pt-2">
      <div class="row g-3 justify-content-center">

        <!-- ✅ Cards por almacén -->
        <t t-foreach="warehouses" t-as="wh" t-key="wh.warehouse_id">
          <div class="col-12 col-sm-12 col-lg-12">
            <div class="card border-0 shadow-sm mega_kpi_card2 h-100">
              <div class="mega_kpi_topbar"></div>

              <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between gap-2">
                  <div class="mega_kpi_title2 text-truncate" t-att-title="wh.warehouse_name">
                    <t t-esc="wh.warehouse_name"/>
                  </div>
                  <span class="mega_kpi_badge">
                    <i class="fa fa-warehouse me-1"/> Sede
                  </span>
                </div>

                <!-- ✅ TOTAL con impuestos -->
                <div class="mega_kpi_value2 mt-2">
                  $ <t t-esc="(wh.total_sales || 0).toLocaleString()"/>
                </div>

                <!-- ✅ SUBTOTAL sin impuestos -->
                <div class="text-muted small mt-1">
                  Subtotal: $ <t t-esc="(wh.subtotal_untaxed || 0).toLocaleString()"/>
                </div>

                <!-- ✅ Cantidad de facturas -->
                <div class="mega_kpi_sub2 mt-1">
                  <strong><t t-esc="wh.count_invoices || 0"/></strong> facturas
                </div>

              </div>
            </div>
          </div>
        </t>

        <!-- ✅ CARD TOTAL -->
        <div class="col-12 col-sm-12 col-lg-12" t-if="!props.option">
          <div class="card border-0 shadow-sm mega_kpi_card2 h-100">
            <div class="mega_kpi_topbar"></div>

            <div class="card-body p-3">
              <div class="d-flex align-items-start justify-content-between gap-2">
                <div class="mega_kpi_title2">TOTAL</div>
                <span class="mega_kpi_badge">
                  <i class="fa fa-layer-group me-1"/> Global
                </span>
              </div>

              <!-- ✅ TOTAL con impuestos -->
              <div class="mega_kpi_value2 mt-2">
                $ <t t-esc="(grand.total_sales || 0).toLocaleString()"/>
              </div>

              <!-- ✅ SUBTOTAL sin impuestos -->
              <div class="text-muted small mt-1">
                Subtotal: $ <t t-esc="(grand.subtotal_untaxed || 0).toLocaleString()"/>
              </div>

              <!-- ✅ Cantidad de facturas -->
              <div class="mega_kpi_sub2 mt-1">
                <strong><t t-esc="grand.count_invoices || 0"/></strong> facturas
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>
  </t>

</templates>
