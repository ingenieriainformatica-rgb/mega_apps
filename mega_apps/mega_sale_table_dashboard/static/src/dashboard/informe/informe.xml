<templates xml:space="preserve">

  <t t-name="mega_dashboard.KpiCards">
    <section class="container-fluid px-3 px-lg-4 pt-2 mb-5">
      <div class="row g-3 justify-content-center">

        <!-- ✅ 1) SEDES -->
        <t t-foreach="warehouses" t-as="wh" t-key="wh.warehouse.id">
          <div class="col-12">

            <!-- ✅ HEADER / TÍTULO de SEDE (sin card) -->
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
              <div class="d-flex align-items-center gap-2">
                <!-- Línea decorativa -->
                <span style="width:10px;height:28px;border-radius:8px;display:inline-block;background:#7FB342;"></span>

                <!-- Título -->
                <div class="d-flex flex-column">
                  <div class="fw-bold text-uppercase text-truncate"
                       style="font-size: 1.05rem; color:#1A3C6B;"
                       t-att-title="wh.warehouse.name">
                    <t t-esc="wh.warehouse.name"/>
                  </div>
                  <div class="text-muted small">
                    Resultados por diario
                  </div>
                </div>
              </div>

              <!-- Badge -->
              <span class="badge rounded-pill bg-light text-dark border">
                <i class="fa fa-warehouse me-1"/> Sede
              </span>
            </div>

            <!-- Separador suave -->
            <div class="border-top mb-3" style="opacity:.15;"></div>

            <!-- ✅ DIARIOS (cards) -->
            <div class="row g-3 mb-4">
              <t t-foreach="wh.journals" t-as="j" t-key="j.journal.id">
                <div class="col-12 col-md-6 col-lg-12">

                  <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-body p-3">

                      <!-- Título del diario -->
                      <div class="d-flex align-items-start justify-content-between gap-2">
                        <div class="fw-bold text-truncate" t-att-title="j.journal.name" style="color:#1A3C6B;">
                          <t t-esc="j.journal.name"/>
                        </div>

                        <!-- Badge: Diario o Nota crédito -->
                        <t t-if="j.is_credit_note_journal">
                          <span class="badge rounded-pill bg-light text-dark border">
                            <i class="fa fa-rotate-left me-1"/> Nota crédito
                          </span>
                        </t>
                        <t t-else="">
                          <span class="badge rounded-pill bg-light text-dark border">
                            <i class="fa fa-book me-1"/> Diario
                          </span>
                        </t>
                      </div>

                      <!-- ✅ KPI: depende si es nota crédito o no -->
                      <t t-set="kpi" t-value="j.is_credit_note_journal and j.notas_credito or j.facturado"/>

                      <div class="mt-2">

                        <div class="text-muted small">
                          <t t-if="j.is_credit_note_journal">Notas crédito</t>
                          <t t-else="">Facturado</t>
                        </div>

                        <div class="fw-bold" style="font-size:1.35rem;">

                          <span class="fw-semibold">
                            Subtotal:
                            $ <t t-esc="(((kpi &amp;&amp; kpi.subtotal_untaxed) || 0)).toLocaleString()"/>
                          </span>
                        </div>

                        <!-- ✅ Subtotal + conteo MÁS visibles -->
                        <div class="mt-2 d-flex align-items-center gap-2 flex-wrap"
                            style="font-size: 0.98rem; color:#1A3C6B;">
                            $ <t t-esc="(((kpi &amp;&amp; kpi.total_sales) || 0)).toLocaleString()"/>

                          <span style="opacity:.35;">•</span>

                          <span class="fw-bold"
                                style="background: rgba(127,179,66,.12); border: 1px solid rgba(127,179,66,.30); padding: 2px 10px; border-radius: 999px;">
                            <t t-esc="((kpi &amp;&amp; kpi.count_invoices) || 0)"/>
                            <t t-if="j.is_credit_note_journal"> notas</t>
                            <t t-else=""> facturas</t>
                          </span>
                        </div>

                      </div>


                    </div>
                  </div>

                </div>
              </t>
            </div>
          </div>
        </t>

      </div>
    </section>
  </t>

</templates>
