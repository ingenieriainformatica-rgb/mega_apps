<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="mega_dashboard.KpiIndicators">
    <div class="mega-analytics-indicators">
      <div class="mega-section-title px-1">
        <i class="fa fa-tachometer"/>
        <span>Indicadores generales</span>
      </div>
      <div class="row g-3">
        <t t-foreach="cards" t-as="card" t-key="card.id">
          <div class="col-12 col-md-4">
            <div class="mega-kpi-card h-100">
              <div class="mega-kpi-topbar" t-att-style="'background:' + card.color"/>
              <div class="p-3">
                <div class="mega-kpi-label">
                  <i t-att-class="'fa ' + card.icon + ' me-1'"/>
                  <t t-esc="card.label"/>
                </div>
                <div class="mega-kpi-value mt-1">
                  <t t-esc="card.display"/>
                </div>
              </div>
            </div>
          </div>
        </t>
      </div>
    </div>
  </t>
</templates>
