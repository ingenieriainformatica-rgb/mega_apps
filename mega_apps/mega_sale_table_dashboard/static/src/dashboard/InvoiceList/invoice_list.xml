<templates xml:space="preserve">
  <t t-name="mega_dashboard.InvoiceList">

    <t t-set="groups" t-value="invoices || []"/>

    <t t-if="!groups.length">
      <div class="text-muted text-center py-4">
        <i class="fa fa-info-circle me-1"/> Sin datos para el filtro seleccionado
      </div>
    </t>

    <!-- ✅ Por sede -->
    <t t-foreach="groups" t-as="g" t-key="g.warehouse.id">
      <div class="card mega-result-card border-0 shadow-sm mb-4 rounded-4 overflow-hidden"
           style="box-shadow: 0 12px 26px rgba(0,0,0,.08);">

        <!-- Header sede -->
        <div class="card-header mega-result-header bg-white d-flex justify-content-between align-items-center py-3"
             style="border-bottom: 1px solid rgba(26,60,107,.08);">
          <div class="d-flex align-items-center gap-2">
            <span class="mega-result-accent" style="width:10px;height:28px;border-radius:8px;display:inline-block;background:#7FB342;"></span>
            <div>
              <div class="fw-bold text-uppercase" style="color:#1A3C6B;">
                <t t-esc="g.warehouse.name"/>
              </div>
              <div class="text-muted small">Movimientos por diario</div>
            </div>
          </div>

          <span class="badge mega-journal-badge rounded-pill bg-light text-dark border"
                style="padding:6px 10px;">
            <i class="fa fa-layer-group me-1"/> <t t-esc="(g.journals || []).length"/> diarios
          </span>
        </div>

        <div class="card-body mega-result-body p-3 p-lg-4">

          <!-- ✅ Por diario (panel) -->
          <t t-foreach="(g.journals || [])" t-as="j" t-key="j.journal.id">
            <t t-set="rows" t-value="j.moves || []"/>

            <!-- (Opcional) Ocultar diarios sin filas -->
            <t t-if="rows.length">

              <div class="mega-journal-panel mb-3 rounded-4 overflow-hidden"
                   style="border:1px solid rgba(26,60,107,.10); background: rgba(26,60,107,.02);">

                <!-- Header diario -->
                <div class="mega-journal-header d-flex justify-content-between align-items-center px-3 py-2 bg-white"
                     style="border-bottom: 1px solid rgba(26,60,107,.08);">
                  <div class="d-flex align-items-center gap-2">
                    <!-- <span class="badge rounded-pill bg-light text-dark border">
                      <i class="fa fa-book me-1"/> Diario
                    </span> -->

                    <div class="fw-semibold text-truncate" style="max-width: 60vw; color:#1A3C6B;"
                         t-att-title="j.journal.name">
                      <t t-esc="j.journal.name"/>
                    </div>

                    <!-- <t t-if="j.is_credit_note_journal">
                      <span class="badge rounded-pill bg-light text-dark border">
                        <i class="fa fa-rotate-left me-1"/> Nota crédito
                      </span>
                    </t>
                    <t t-else="">
                      <span class="badge rounded-pill bg-light text-dark border">
                        <i class="fa fa-file-invoice me-1"/> Factura
                      </span>
                    </t> -->
                  </div>

                  <span class="badge mega-journal-badge rounded-pill bg-light text-dark border">
                    <t t-esc="rows.length"/> registros
                  </span>
                </div>

                <!-- Tabla -->
                <div class="mega-result-table table-responsive bg-white">
                  <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                      <tr>
                        <th style="width:130px">Número</th>
                        <th style="min-width:220px">Cliente</th>
                        <th style="min-width:260px">Concepto</th>
                        <th style="width:130px">Fecha</th>
                        <th class="text-end" style="width:170px">Subtotal</th>
                        <th class="text-end" style="width:170px">Total</th>
                      </tr>
                    </thead>

                    <tbody>
                      <t t-foreach="rows" t-as="inv" t-key="inv.id">
                        <tr class="cursor-pointer"
                            t-on-click="openInvoice"
                            t-att-data-id="inv.id"
                            title="Abrir documento"
                            style="cursor:pointer;">
                          <td class="fw-semibold"><t t-esc="inv.number"/></td>
                          <td class="text-truncate"><t t-esc="inv.partner"/></td>
                          <td class="text-truncate"><t t-esc="inv.concepto"/></td>
                          <td class="text-muted"><t t-esc="inv.invoice_date"/></td>
                          <td class="text-end">
                            $ <t t-esc="(inv.subtotal_untaxed || 0).toLocaleString()"/>
                          </td>
                          <td class="text-end fw-semibold">
                            $ <t t-esc="(inv.total || 0).toLocaleString()"/>
                          </td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </div>

              </div>

            </t>
          </t>

          <!-- Si todos los diarios estaban vacíos -->
          <t t-if="!(g.journals || []).length">
            <div class="text-muted text-center py-3">Sin diarios configurados</div>
          </t>

        </div>
      </div>
    </t>

  </t>
</templates>
