<templates xml:space="preserve">
  <t t-name="mega_dashboard.InvoiceList">
    <t t-set="groups" t-value="invoices || []"/>

    <t t-if="!groups.length">
      <div class="text-muted text-center py-3">Sin datos para el filtro seleccionado</div>
    </t>

    <t t-foreach="groups" t-as="g" t-key="g.warehouse_id">
      <div class="card border-0 shadow-sm mb-3">

        <div class="card-header d-flex justify-content-between align-items-center">
          <div>
            <strong><t t-esc="g.warehouse_name"/></strong>
            <div class="text-muted small">Facturas relacionadas</div>
          </div>

          <span class="badge bg-secondary">
            <t t-esc="(g.invoices || []).length"/> facturas
          </span>
        </div>

        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="width:110px">Factura</th>
                <th style="min-width:220px">Cliente</th>
                <th style="min-width:220px">Concepto</th>
                <th style="width:110px">Fecha</th>
                <th class="text-end" style="width:140px">Subtotal</th>
                <th class="text-end" style="width:140px">Total</th>
              </tr>
            </thead>

            <tbody>
              <t t-if="!(g.invoices || []).length">
                <tr>
                  <td colspan="6" class="text-muted text-center py-3">
                    Sin facturas para esta sede
                  </td>
                </tr>
              </t>

              <t t-foreach="(g.invoices || [])" t-as="inv" t-key="inv.id">
                <tr class="cursor-pointer"
                    t-on-click="openInvoice"
                    t-att-data-id="inv.id"
                    title="Abrir factura">
                  <td><t t-esc="inv.number"/></td>
                  <td><t t-esc="inv.partner"/></td>
                  <td><t t-esc="inv.concepto"/></td>
                  <td><t t-esc="inv.invoice_date"/></td>
                  <td class="text-end"><t t-esc="inv.subtotal_untaxed"/></td>
                  <td class="text-end"><t t-esc="inv.total"/></td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
      </div>
    </t>
  </t>
</templates>
