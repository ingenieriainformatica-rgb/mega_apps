<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="mega_dashboard.KpiBanner">

    <div class="mega-kpi-banner">
      <div class="container-fluid py-3 px-4">
        <div class="row g-3">

          <t t-foreach="metrics" t-as="metric" t-key="metric.id">
            <div class="col-6 col-md-4 col-lg">

              <div class="mega-kpi-card h-100 d-flex">
                <!-- Barra de color lateral (distinta por KPI) -->
                <div class="mega-kpi-accent" t-att-style="'background:' + metric.color"/>

                <div class="p-3 flex-grow-1 min-w-0">
                  <!-- Label -->
                  <div class="mega-kpi-label">
                    <i t-att-class="'fa ' + metric.icon + ' me-1'"/>
                    <t t-esc="metric.label"/>
                  </div>

                  <!-- Valor principal -->
                  <div class="mega-kpi-value mt-1">
                    <t t-esc="metric.display"/>
                  </div>

                  <!-- Conteo opcional (p.ej. NC) -->
                  <t t-if="metric.subDisplay">
                    <div class="mega-kpi-sub mt-1">
                      <t t-esc="metric.subDisplay"/>
                    </div>
                  </t>

                </div>
              </div>

            </div>
          </t>

        </div>
      </div>
    </div>

  </t>
</templates>
