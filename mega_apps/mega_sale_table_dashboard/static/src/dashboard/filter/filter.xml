<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="mega_dashboard.DateFilterBar">

    <div class="mega-filter-bar">

      <!-- ══ Fila 1: Período ══════════════════════════════════════ -->
      <div class="mega-filter-row d-flex align-items-center gap-3 flex-wrap">

        <!-- Etiqueta de sección -->
        <span class="mega-filter-section-label">
          <i class="fa fa-calendar-o me-1"/>Período
        </span>

        <div class="mega-filter-divider"/>

        <!-- Shortcuts de período -->
        <div class="mega-shortcut-group d-flex align-items-center gap-2">
          <t t-foreach="shortcuts" t-as="sc" t-key="sc.key">
            <button
              t-att-class="state.activeShortcut === sc.key
                            ? 'mega-shortcut-btn mega-shortcut-active'
                            : 'mega-shortcut-btn'"
              t-on-click="() => this.applyShortcut(sc.key)">
              <t t-esc="sc.label"/>
            </button>
          </t>
        </div>

        <div class="mega-filter-divider"/>

        <!-- Rango de fechas con Odoo DatePicker nativo -->
        <div class="mega-date-range d-flex align-items-center gap-3">

          <!-- Desde -->
          <div class="mega-date-field d-flex align-items-center gap-2">
            <span class="mega-filter-label">Desde</span>
            <div t-ref="dateFromAnchor">
              <button class="mega-date-btn" t-on-click="openDateFrom">
                <i class="fa fa-calendar-o"/>
                <span t-esc="formatDateDisplay(state.date_from)"/>
              </button>
            </div>
          </div>

          <span style="color:rgba(33,37,41,.20); font-size:16px;">→</span>

          <!-- Hasta -->
          <div class="mega-date-field d-flex align-items-center gap-2">
            <span class="mega-filter-label">Hasta</span>
            <div t-ref="dateToAnchor">
              <button class="mega-date-btn" t-on-click="openDateTo">
                <i class="fa fa-calendar-o"/>
                <span t-esc="formatDateDisplay(state.date_to)"/>
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- ══ Fila 2: Sede y Diario ════════════════════════════════ -->
      <div class="mega-filter-select-row d-flex align-items-center gap-4 flex-wrap mt-3">

        <span class="mega-filter-section-label">
          <i class="fa fa-filter me-1"/>Vista
        </span>

        <div class="mega-filter-divider"/>

        <!-- Sede -->
        <div class="mega-select-wrapper d-flex align-items-center gap-2">
          <span class="mega-filter-icon"><i class="fa fa-building-o"/></span>
          <select
            class="form-select mega-select"
            t-on-change="onChangeWarehouse"
            t-att-disabled="!props.loadingWarehouses">
            <option value="allHeadquarters">Todas las sedes</option>
            <t t-foreach="props.warehouses or []" t-as="wh" t-key="wh.id">
              <option t-att-value="wh.id"
                      t-att-selected="state.warehouse_id == wh.id">
                <t t-esc="wh.name"/>
              </option>
            </t>
          </select>
        </div>

        <!-- Diario -->
        <div class="mega-select-wrapper d-flex align-items-center gap-2">
          <span class="mega-filter-icon"><i class="fa fa-book"/></span>
          <select
            class="form-select mega-select"
            t-on-change="onChangeJournal"
            t-att-disabled="!props.loadingWarehouses">
            <option value="allJournal"
                    t-att-selected="state.journal_id === 'allJournal'">
              Todos los diarios
            </option>
            <t t-foreach="props.journals or []" t-as="j" t-key="j.id">
              <option t-att-value="j.id"
                      t-att-selected="state.journal_id == j.id">
                <t t-esc="j.name"/>
              </option>
            </t>
          </select>
        </div>

        <!-- Asesor -->
        <div class="mega-select-wrapper d-flex align-items-center gap-2">
          <span class="mega-filter-icon"><i class="fa fa-user-o"/></span>
          <select
            class="form-select mega-select"
            t-on-change="onChangeAdvisor"
            t-att-disabled="!props.loadingWarehouses">
            <option value="allAdvisors"
                    t-att-selected="state.advisor_id === 'allAdvisors'">
              Todos los asesores
            </option>
            <t t-foreach="props.advisors or []" t-as="a" t-key="a.id">
              <option t-att-value="a.id"
                      t-att-selected="state.advisor_id == a.id">
                <t t-esc="a.name"/>
              </option>
            </t>
          </select>
        </div>

        <!-- Empresa (solo si el usuario tiene más de una compañía permitida) -->
        <t t-if="props.companies and props.companies.length > 1">
          <div class="mega-select-wrapper d-flex align-items-center gap-2">
            <span class="mega-filter-icon"><i class="fa fa-industry"/></span>
            <select
              class="form-select mega-select"
              t-on-change="onChangeCompany"
              t-att-disabled="!props.loadingWarehouses">
              <option value="allCompanies"
                      t-att-selected="state.company_id === 'allCompanies'">
                Todas las empresas
              </option>
              <t t-foreach="props.companies or []" t-as="c" t-key="c.id">
                <option t-att-value="c.id"
                        t-att-selected="state.company_id == c.id">
                  <t t-esc="c.name"/>
                </option>
              </t>
            </select>
          </div>
        </t>

        <!-- Estado del documento -->
        <div class="mega-select-wrapper d-flex align-items-center gap-2">
          <span class="mega-filter-icon"><i class="fa fa-flag-o"/></span>
          <select
            class="form-select mega-select"
            t-on-change="onChangeState"
            t-att-disabled="!props.loadingWarehouses">
            <t t-foreach="stateOptions" t-as="opt" t-key="opt.value">
              <option t-att-value="opt.value"
                      t-att-selected="state.state_filter === opt.value">
                <t t-esc="opt.label"/>
              </option>
            </t>
          </select>
        </div>

        <!-- Spinner inicial -->
        <t t-if="!props.loadingWarehouses">
          <span class="text-muted d-flex align-items-center gap-1" style="font-size:13px;">
            <i class="fa fa-circle-o-notch fa-spin"/>
            Cargando sedes…
          </span>
        </t>

      </div>

    </div>

  </t>
</templates>
