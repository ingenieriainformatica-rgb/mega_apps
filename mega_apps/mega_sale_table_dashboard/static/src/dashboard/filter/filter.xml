<templates xml:space="preserve">
  <t t-name="mega_dashboard.DateFilterBar">
    <section class="container-fluid px-3 px-lg-4 pb-2">
      <div class="card border-0 shadow-sm">
        <div class="card-body py-3">

          <div class="row align-items-center g-3">
            <div class="col-12">
              <!-- IMPORTANTE: quité justify-content-lg-end porque ya no hace falta -->
              <div class="row g-2">

                <!-- Sede -->
                <div class="col-12 col-md-6 col-lg-3">
                  <label class="form-label text-muted small mb-1">Sede</label>
                  <div class="input-group input-group-lg">
                    <span class="input-group-text">
                      <i class="fa fa-folder-open-o"/>
                    </span>

                    <select class="form-select"
                            t-ref="input_warehouse_id"
                            t-on-change="onChangeWarehouse">
                      <t t-if="!props.loadingWarehouses">
                        <option disabled="disabled">No tiene sedes mapeadas...</option>
                      </t>

                      <t t-else="">
                        <option value="allHeadquarters">Todos las sedes</option>
                        <t t-foreach="(props.warehouses || [])" t-as="wh" t-key="wh.id">
                          <option t-att-value="wh.id"><t t-esc="wh.name"/></option>
                        </t>
                      </t>
                    </select>
                  </div>
                </div>

                <!-- Diario -->
                <div class="col-12 col-md-6 col-lg-3">
                  <label class="form-label text-muted small mb-1">Diario</label>
                  <div class="input-group input-group-lg">
                    <span class="input-group-text">
                      <i class="fa fa-list-alt"/>
                    </span>

                    <select class="form-select" t-ref="input_journal_id">
                      <t t-if="!props.loadingJournals">
                        <option disabled="disabled">Cargando diarios...</option>
                      </t>
                      <t t-else="">
                        <option value="allJournal">Todos los diarios</option>
                        <t t-foreach="(props.journals || [])" t-as="jour" t-key="jour.id">
                          <option t-att-value="jour.id"><t t-esc="jour.name"/></option>
                        </t>
                      </t>
                    </select>
                  </div>
                </div>

                <!-- Desde -->
                <div class="col-6 col-md-3 col-lg-2">
                  <label class="form-label text-muted small mb-1">Desde</label>
                  <div class="input-group input-group-lg">
                    <input type="date"
                           class="form-control"
                           t-att-value="state.date_from"
                           t-ref="input_date_from"/>
                    <span class="input-group-text">
                      <i class="fa fa-calendar"/>
                    </span>
                  </div>
                </div>

                <!-- Hasta -->
                <div class="col-6 col-md-3 col-lg-2">
                  <label class="form-label text-muted small mb-1">Hasta</label>
                  <div class="input-group input-group-lg">
                    <input type="date"
                           class="form-control"
                           t-att-value="state.date_to"
                           t-ref="input_date_to"/>
                    <span class="input-group-text">
                      <i class="fa fa-calendar"/>
                    </span>
                  </div>
                </div>

                <!-- Botón -->
                <div class="col-12 col-lg-2 d-grid align-self-end col-lg-auto">
                  <button class="btn btn-primary btn-lg" t-on-click="onClickFilter">
                    <i class="fa fa-filter me-1"/>
                    Filtrar
                  </button>
                </div>

              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </t>
</templates>
