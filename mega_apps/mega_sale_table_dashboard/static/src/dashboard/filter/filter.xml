<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="mega_dashboard.DateFilterBar">

    <div class="mega-filter-bar">

      <!-- ── Fila 1: Shortcuts de período + inputs de fecha ── -->
      <div class="mega-filter-row d-flex align-items-center justify-content-between flex-wrap gap-2">

        <!-- Shortcuts de período -->
        <div class="d-flex align-items-center gap-1">
          <t t-foreach="shortcuts" t-as="sc" t-key="sc.key">
            <button
              t-att-class="state.activeShortcut === sc.key
                            ? 'mega-shortcut-btn mega-shortcut-active'
                            : 'mega-shortcut-btn'"
              t-on-click="() => this.applyShortcut(sc.key)">
              <t t-esc="sc.label"/>
            </button>
          </t>
        </div>

        <!-- Inputs de fecha (siempre visibles) -->
        <div class="d-flex align-items-center gap-3 flex-wrap">

          <div class="d-flex align-items-center gap-1">
            <label class="mega-filter-label">Desde</label>
            <input
              type="date"
              class="mega-date-input form-control form-control-sm"
              t-att-value="state.date_from"
              t-on-change="onChangeDateFrom"
            />
          </div>

          <div class="d-flex align-items-center gap-1">
            <label class="mega-filter-label">Hasta</label>
            <input
              type="date"
              class="mega-date-input form-control form-control-sm"
              t-att-value="state.date_to"
              t-on-change="onChangeDateTo"
            />
          </div>

        </div>
      </div>

      <!-- ── Fila 2: Selectores de sede y diario ── -->
      <div class="d-flex align-items-center gap-3 flex-wrap mt-2">

        <!-- Sede -->
        <div class="d-flex align-items-center gap-2">
          <span class="mega-filter-icon"><i class="fa fa-building-o"/></span>
          <select
            class="form-select form-select-sm mega-select"
            t-on-change="onChangeWarehouse"
            t-att-disabled="!props.loadingWarehouses">
            <option value="allHeadquarters">Todas las sedes</option>
            <t t-foreach="props.warehouses or []" t-as="wh" t-key="wh.id">
              <option t-att-value="wh.id"
                      t-att-selected="state.warehouse_id == wh.id">
                <t t-esc="wh.name"/>
              </option>
            </t>
          </select>
        </div>

        <!-- Diario -->
        <div class="d-flex align-items-center gap-2">
          <span class="mega-filter-icon"><i class="fa fa-book"/></span>
          <select
            class="form-select form-select-sm mega-select"
            t-on-change="onChangeJournal"
            t-att-disabled="!props.loadingWarehouses">
            <option value="allJournal"
                    t-att-selected="state.journal_id === 'allJournal'">
              Todos los diarios
            </option>
            <t t-foreach="props.journals or []" t-as="j" t-key="j.id">
              <option t-att-value="j.id"
                      t-att-selected="state.journal_id == j.id">
                <t t-esc="j.name"/>
              </option>
            </t>
          </select>
        </div>

        <!-- Spinner inicial (solo mientras carga la lista de sedes) -->
        <t t-if="!props.loadingWarehouses">
          <span class="text-muted" style="font-size:12px;">
            <i class="fa fa-circle-o-notch fa-spin me-1"/>
            Cargando sedes...
          </span>
        </t>

      </div>

    </div>

  </t>
</templates>
