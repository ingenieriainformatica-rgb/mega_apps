<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="mega_dashboard.SaleDashboard">
    <Layout display="display" className="'o_dashboard h-100 overflow-y-auto'">

      <DashboardHero />

      <DateFilterBar
        warehouses="state.warehouses"
        loadingWarehouses="state.loadingWarehouses"
        onClickFilter.bind="onClickFilter"
        onChangeWarehouse.bind="onChangeWarehouse"
        journals="state.journals"
        loadingJournals="state.loadingJournals"
      />

      <!-- Layout principal -->
      <div class="container-fluid mb-5 mt-5" t-if="statistics.isReady">
        <div class="row g-3">

          <!-- Columna 1 -->
          <div class="col-12 col-lg-4">
            <Informe data="statistics.sales.groups" grand="statistics.sales.grand" option="statistics.isReadyWarehouse"/>
          </div>

          <!-- Columna 2 (placeholder) -->
          <div class="col-12 col-lg-8">
            <InvoiceList invoicesList="statistics.sales.groups"/>
          </div>

        </div>
      </div>


    </Layout>
  </t>
</templates>
