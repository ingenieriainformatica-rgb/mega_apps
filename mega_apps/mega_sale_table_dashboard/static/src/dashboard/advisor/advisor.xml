<templates xml:space="preserve">
  <t t-name="mega_dashboard.Advisor">

    <t t-set="advisors" t-value="rows || []"/>

    <t t-if="!advisors.length">
      <div class="text-muted text-center py-4">
        <i class="fa fa-info-circle me-1"/> Sin datos para el filtro seleccionado
      </div>
    </t>

    <t t-foreach="advisors" t-as="g" t-key="g.warehouse.id">
        <div class="card mega-result-card border-0 shadow-sm mb-4 rounded-4 overflow-hidden"
           style="box-shadow: 0 12px 26px rgba(0,0,0,.08);">

            <!-- Header sede -->
            <div class="card-header mega-result-header bg-white d-flex justify-content-between align-items-center py-3"
                style="border-bottom: 1px solid rgba(26,60,107,.08);">
                <div class="d-flex align-items-center gap-2">
                    <span class="mega-result-accent" style="width:10px;height:28px;border-radius:8px;display:inline-block;background:#003ff1;"></span>
                    <div>
                    <div class="fw-bold text-uppercase" style="color:#1A3C6B;">
                        <t t-esc="g.warehouse.name"/>
                    </div>
                    <div class="text-muted small">Asesores</div>
                    </div>
                </div>
            </div>

            <div class="card-body mega-result-body p-3 p-lg-4">
                <!-- ✅ Por asesor -->
                <t t-foreach="(g.journals || [])" t-as="j" t-key="j.journal.id">

                    <t t-set="rowsAdvisor" t-value="j.conceptos_totales || []"/>
                    <t t-if="rowsAdvisor.length">
                        <!-- Título del diario -->
                        <div class="mega-journal-header d-flex align-items-start justify-content-between gap-2 mt-3 mb-2">
                            <div class="fw-bold text-truncate" t-att-title="j.journal.name" style="color:#1A3C6B;">
                            <t t-esc="j.journal.name"/>
                            </div>

                            <!-- Badge: Diario o Nota crédito -->
                            <t t-if="j.is_credit_note_journal">
                            <span class="badge mega-journal-badge rounded-pill bg-light text-dark border">
                                <i class="fa fa-rotate-left me-1"/> Nota crédito
                            </span>
                            </t>
                            <t t-else="">
                            <span class="badge mega-journal-badge rounded-pill bg-light text-dark border">
                                <i class="fa fa-book me-1"/> Diario
                            </span>
                            </t>
                        </div>

                        <div class="mega-result-table table-responsive bg-white">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Asesor</th>
                                        <th>Subtotal</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="rowsAdvisor" t-as="inv" t-key="(inv.concepto || ('row_' + inv_index))">

                                        <tr>
                                            <td><t t-esc="inv.count"/></td>
                                            <td><t t-esc="inv.concepto"/></td>
                                            <td class="text-truncate">
                                                $ <t t-esc="(inv.subtotal_untaxed || 0).toLocaleString()"/>
                                            </td>
                                            <td class="text-muted">
                                                $ <t t-esc="(inv.total_sales || 0).toLocaleString()"/>
                                            </td>
                                        </tr>

                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </div>

        </div>
    </t>

  </t>
</templates>
