<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_supplier_trace_wizard_form" model="ir.ui.view">
        <field name="name">sale.supplier.trace.wizard.form</field>
        <field name="model">sale.supplier.trace.wizard</field>
        <field name="arch" type="xml">
            <form string="Trazabilidad de proveedor por venta">
                <sheet>
                    <div class="oe_title">
                        <h1>Trazabilidad de proveedor por venta</h1>
                        <p class="text-muted">
                            Consulta y exporta a Excel la trazabilidad entre productos vendidos y sus
                            posibles proveedores de compra, clasificada como Exacto, Probable o No determinado.
                            No modifica facturas, inventario ni el reporte estandar de facturacion.
                        </p>
                    </div>
                    <group>
                        <group string="Rango">
                            <field name="date_from" string="Fecha desde"/>
                            <field name="date_to" string="Fecha hasta"/>
                            <field name="company_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group string="Tipo de documento y estado">
                            <field name="doc_type"/>
                            <field name="traceability_status_filter"/>
                            <field name="include_services"/>
                        </group>
                    </group>
                    <group invisible="1">
                        <group string="Filtros opcionales">
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="product_categ_id"/>
                        </group>
                        <group string=" ">
                            <field name="move_id"/>
                            <field name="supplier_id"/>
                            <field name="journal_id"/>
                        </group>
                    </group>

                    <notebook invisible="not preview_done">
                        <page string="Vista previa" name="preview">
                            <group>
                                <group string="Alcance analizado">
                                    <field name="preview_documents"/>
                                    <field name="preview_lines"/>
                                    <field name="preview_rows"/>
                                </group>
                                <group string="Cantidades por estado">
                                    <field name="preview_qty_exact"/>
                                    <field name="preview_qty_probable"/>
                                    <field name="preview_qty_not_determined"/>
                                </group>
                            </group>
                            <group>
                                <group string="Cobertura">
                                    <field name="preview_pct_exact"/>
                                    <field name="preview_pct_probable"/>
                                    <field name="preview_pct_not_determined"/>
                                </group>
                                <group string="Importes">
                                    <field name="preview_currency_id" invisible="1"/>
                                    <field name="preview_total_original"/>
                                    <field name="preview_total_attributed"/>
                                    <field name="preview_difference"/>
                                </group>
                            </group>
                            <group string="Advertencias">
                                <field name="preview_warning" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                    <group invisible="not xlsx_file">
                        <field name="xlsx_file" filename="xlsx_filename" readonly="1"/>
                        <field name="xlsx_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Vista previa" class="btn-secondary" invisible="1"/>
                    <button name="action_generate_xlsx" type="object" string="Descargar Excel"
                            class="btn-primary"
                            groups="mega_sale_supplier_trace_xlsx.group_sale_supplier_trace_export"/>
                    <button name="action_close" type="object" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_supplier_trace_wizard" model="ir.actions.act_window">
        <field name="name">Trazabilidad de proveedor por venta</field>
        <field name="res_model">sale.supplier.trace.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
