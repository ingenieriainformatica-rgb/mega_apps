<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_invoice_report_tree_supplier" model="ir.ui.view">
        <field name="name">account.invoice.report.tree.supplier</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.account_invoice_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="supplier_id" optional="show"/>
            </xpath>
        </field>
    </record>

