<odoo>
    <record id="view_battery_price_import_wizard_form" model="ir.ui.view">
        <field name="name">mega.battery.price.import.wizard.form</field>
        <field name="model">mega.battery.price.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar precios de baterías">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>

                <group string="Opciones de actualización">
                    <field name="update_description" widget="boolean_toggle"/>
                    <field name="update_stock" widget="boolean_toggle"/>
                    <field name="update_prices" widget="boolean_toggle"/>
                </group>

                <group string="Resumen" invisible="not summary">
                    <field name="summary" nolabel="1" readonly="1"/>
                </group>

                <footer>
                    <button name="action_import_prices" string="Importar precios" type="object" class="btn-primary"/>

                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_battery_price_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar precios baterías</field>
        <field name="res_model">mega.battery.price.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_battery_price_import_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
