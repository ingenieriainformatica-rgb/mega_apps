<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_mega_battery_catalog_import_wizard_form" model="ir.ui.view">
        <field name="name">mega.battery.catalog.import.wizard.form</field>
        <field name="model">mega.battery.catalog.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar catálogo MAC">
                <sheet>
                    <group>
                        <group string="Archivo">
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="application_type"/>
                            <field name="state" readonly="1"/>
                        </group>

                        <group string="Opciones">
                            <field name="create_missing_brands"/>
                            <field name="create_missing_models"/>
                            <field name="link_products"/>
                            <field name="update_existing"/>
                        </group>
                    </group>

                    <group string="Resumen">
                        <field name="summary" readonly="1" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="Validación">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="row_number"/>
                                    <field name="status"/>
                                    <field name="brand_name"/>
                                    <field name="model_base_name"/>
                                    <field name="original_vehicle_name"/>
                                    <field name="fuel_type"/>
                                    <field name="year_from"/>
                                    <field name="year_to"/>
                                    <field name="engine_capacity"/>
                                    <field name="battery_qty"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button name="action_validate" type="object" string="Validar archivo" class="btn-primary" />

                    <button name="action_import" type="object" string="Importar validado" class="btn-primary" invisible="state != 'validated'" />

                    <button string="Cerrar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mega_battery_catalog_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar catálogo MAC</field>
        <field name="res_model">mega.battery.catalog.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
