<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fleet_repair_form" model="ir.ui.view">
            <field name="name">fleet.repair.form</field>
            <field name="model">fleet.repair</field>
            <field name="arch" type="xml">
                <form string="Car Repair">
                    <header>
                        <button name="action_create_fleet_diagnosis" string="Create Car Diagnosis"
                                invisible="state != 'draft'" type="object" class="oe_highlight" style="float:left;"
                                groups="car_repair_industry.group_fleet_repair_service_manager,car_repair_industry.group_fleet_repair_directeur_commercial"/>

                        <button name="action_flow_assign_technician" string="Asignar técnico"
                                type="object" class="oe_highlight" style="float:left;"
                                invisible="service_flow_state != 'to_assign' or not (portal_technician_id or user_id)"
                                groups="car_repair_industry.group_fleet_repair_service_manager,car_repair_industry.group_fleet_repair_head_technician,car_repair_industry.group_fleet_repair_directeur_commercial"/>

                        <button name="action_reassign_technician"
                                string="Reasignar técnico"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'diagnosis' or not portal_technician_id"
                                groups="car_repair_industry.group_fleet_repair_head_technician,car_repair_industry.group_fleet_repair_service_manager,car_repair_industry.group_fleet_repair_directeur_commercial"/>

                        <button name="action_print_receipt" string="Print Receipt" invisible="state != 'draft'"
                                type="object" style="float:left;"/>
                        <button name="action_print_label" string="Print Label" invisible="state != 'draft'"
                                type="object" style="float:left;"/>
                        <button name="action_test_google_drive_connection" string="Probar Google Drive"
                                type="object" style="float:left;"
                                groups="car_repair_industry.group_fleet_repair_service_manager,base.group_system" invisible="1"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,diagnosis,quote,saleorder,workorder,done"/>
                    </header>
                    <sheet string="Car Repair">

                        <div class="oe_button_box" name="button_box">
                            <button type="object"
                                    name="button_view_workorder"
                                    class="oe_stat_button"
                                    icon="fa-wrench"
                                    invisible="workorder_count == 0" groups="base.group_user">
                                <field name="workorder_count" widget="statinfo" string="Work Order"/>
                            </button>


                            <button type="object"
                                    name="button_view_diagnosis"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square"
                                    invisible="dig_count == 0" groups="base.group_user">
                                <field name="dig_count" widget="statinfo" string="Diagnoses"/>
                            </button>

                            <button type="object"
                                    name="button_view_quotation"
                                    class="oe_stat_button"
                                    icon="fa-usd"
                                    invisible="quotation_count == 0" groups="base.group_user">
                                <field name="quotation_count" widget="statinfo" string="Quotations"/>
                            </button>


                            <button type="object"
                                    name="button_view_saleorder"
                                    class="oe_stat_button"
                                    icon="fa-usd"
                                    invisible="saleorder_count == 0" groups="base.group_user">
                                <field name="saleorder_count" widget="statinfo" string="Sales Orders"/>
                            </button>


                            <button type="object"
                                    name="button_view_invoice"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o"
                                    invisible="inv_count == 0" groups="base.group_user">
                                <field name="inv_count" widget="statinfo" string="Invoices"/>
                            </button>

                            <button type="object"
                                    name="action_view_spare_requests"
                                    class="oe_stat_button"
                                    icon="fa-shopping-cart"
                                    invisible="spare_request_count == 0"
                                    groups="car_repair_industry.group_fleet_repair_spare_warehouse,car_repair_industry.group_fleet_repair_service_manager,base.group_system">
                                <field name="spare_request_count" widget="statinfo" string="Repuestos"/>
                            </button>
                        </div>

                        <div class="oe_title oe_left">
                            <h1>
                                <field name="sequence"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name" readonly="state != 'draft'" string="Descripción"/>
                                <field name="user_id" readonly="1"  options="{'no_create': True, 'no_open':True}"/>
                                <field name="service_flow_state" readonly="1"/>
                                <field name="portal_advisor_id" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                                <field name="portal_technician_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                <field name="road_test_user_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                <field name="purchase_quote_user_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                                <field name="confirm_sale_order" invisible="True"/>
                            </group>
                            <group>
                                <field name="priority" widget="priority" readonly="state != 'draft'"/>
                                <field name="receipt_date" readonly="state != 'draft'"/>
                                <field name="images_ids" widget='many2many_binary' invisible="1"/>
                                <field name="sale_order_id" invisible="True"/>
                                <field name="workorder_id" invisible="True"/>
                                <field name="diagnose_id" readonly="True" invisible="True"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="General">
                                <group string="Client Info">
                                    <group>
                                        <field name="client_id" context="{'show_address': 1}"
                                               options='{"always_reload": True, "no_create": True, "no_open":True}' readonly="state != 'draft'"/>
                                        <field name="contact_name"/>
                                    </group>
                                    <group>
                                        <field name="client_phone" readonly="state != 'draft'"/>
                                        <field name="client_mobile" readonly="state != 'draft'"/>
                                        <field name="client_email" widget="email" readonly="state != 'draft'"/>
                                        <field name="phone"/>
                                    </group>
                                </group>
                                <group string="Recepción">
                                    <group>
                                        <field name="customer_type" widget="selection"/>
                                        <field name="renting_reference"/>
                                        <field name="renting_appointment_validated"/>
                                        <field name="reception_mileage"/>
                                        <field name="reception_fuel_level"/>
                                    </group>
                                    <group>
                                        <field name="delivered_by_name"/>
                                        <field name="delivered_by_phone"/>
                                        <field name="delivered_by_document"/>
                                        <field name="delivered_by_email"/>
                                        <field name="delivered_by_observation"/>
                                    </group>
                                    <group>
                                        <field name="valuables_inside"/>
                                        <field name="valuables_description"/>
                                    </group>
                                    <group>
                                        <field name="received_documents"/>
                                        <field name="reception_general_observations"/>
                                    </group>
                                </group>
                                <separator string="Car Info"/>
                                <field name="fleet_repair_line" readonly="state != 'draft'" widget="one2many_list"/>
                            </page>
                            <page name="external_evidences" string="Evidencias externas">
                                <button name="action_open_drive_upload_wizard" string="Subir fotos a Drive"
                                        type="object" class="btn-primary mb-2"
                                        groups="base.group_user"/>
                                <field name="external_evidence_ids" mode="kanban" readonly="1">
                                    <kanban>
                                        <field name="name"/>
                                        <field name="evidence_type"/>
                                        <field name="evidence_category"/>
                                        <field name="external_url"/>
                                        <field name="description"/>
                                        <field name="uploaded_at"/>
                                        <field name="preview_url"/>
                                        <field name="is_image"/>
                                        <templates>
                                            <t t-name="card">
                                                <div class="oe_kanban_global_click">
                                                    <div t-if="record.is_image.raw_value and record.preview_url.raw_value"
                                                         class="o_kanban_image">
                                                        <img t-att-src="record.preview_url.raw_value"
                                                             t-att-alt="record.name.value"
                                                             style="width: 100%; max-height: 180px; object-fit: cover;"/>
                                                    </div>
                                                    <div t-else="" class="o_kanban_image">
                                                        <div class="text-muted text-center p-4">Sin vista previa</div>
                                                    </div>
                                                    <div class="oe_kanban_details">
                                                        <strong>
                                                            <field name="name"/>
                                                        </strong>
                                                        <div>
                                                            <field name="evidence_type"/>
                                                            <span> · </span>
                                                            <field name="evidence_category"/>
                                                        </div>
                                                        <div class="text-muted">
                                                            <field name="uploaded_at"/>
                                                        </div>
                                                        <div t-if="record.description.raw_value">
                                                            <field name="description"/>
                                                        </div>
                                                        <a t-if="record.external_url.raw_value"
                                                           t-att-href="record.external_url.raw_value"
                                                           target="_blank"
                                                           class="btn btn-primary btn-sm mt-2">
                                                            Abrir en Drive
                                                        </a>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                                <separator string="Detalle de evidencias"/>
                                <field name="external_evidence_ids"
                                       groups="car_repair_industry.group_fleet_repair_service_manager">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="evidence_type"/>
                                        <field name="evidence_category"/>
                                        <field name="external_url" widget="url"/>
                                        <field name="drive_file_id" optional="hide"/>
                                        <field name="mime_type" optional="hide"/>
                                        <field name="description"/>
                                        <field name="uploaded_by" readonly="1"/>
                                        <field name="uploaded_at" readonly="1"/>
                                        <field name="active" column_invisible="1"/>
                                    </list>
                                </field>
                                <field name="external_evidence_ids"
                                       groups="car_repair_industry.group_fleet_repair_technician,!car_repair_industry.group_fleet_repair_service_manager">
                                    <list editable="bottom" delete="0">
                                        <field name="name"/>
                                        <field name="evidence_type"/>
                                        <field name="evidence_category"/>
                                        <field name="external_url" widget="url"/>
                                        <field name="drive_file_id" optional="hide"/>
                                        <field name="mime_type" optional="hide"/>
                                        <field name="description"/>
                                        <field name="uploaded_by" readonly="1"/>
                                        <field name="uploaded_at" readonly="1"/>
                                        <field name="active" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page name="operational_flow" string="Flujo operativo">
                                <group>
                                    <group string="Trazabilidad">
                                        <field name="technician_started_at"/>
                                        <field name="technician_finished_at"/>
                                        <field name="road_test_requested_at"/>
                                        <field name="road_test_started_at"/>
                                        <field name="road_test_finished_at"/>
                                        <field name="sent_to_purchase_at"/>
                                    </group>
                                    <group string="Resultado">
                                        <field name="closure_result"/>
                                        <field name="technical_observation"/>
                                        <field name="requested_materials"/>
                                        <field name="road_test_result"/>
                                        <field name="purchase_quote_note"/>
                                    </group>
                                </group>
                            </page>
                            <page name="reception_checklist" string="Checklist de recepción">
                                <group>
                                    <field name="reception_checklist_template_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                </group>
                                <field name="reception_checklist_line_ids">
                                    <list editable="bottom"
                                          decoration-danger="state == 'bad'"
                                          decoration-warning="state == 'regular'">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name" readonly="1" force_save="1"/>
                                        <field name="state"/>
                                        <field name="observation"/>
                                        <field name="repaired"/>
                                        <field name="template_id" column_invisible="1" force_save="1"/>
                                        <field name="template_line_id" column_invisible="1" force_save="1"/>
                                        <field name="checklist_type" column_invisible="1" force_save="1"/>
                                    </list>
                                </field>
                            </page>
                            <page name="technical_checklist" string="Checklist técnico">
                                <group>
                                    <field name="technical_checklist_template_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                </group>
                                <field name="technical_checklist_line_ids">
                                    <list editable="bottom"
                                          decoration-danger="state == 'bad'"
                                          decoration-warning="state == 'regular'">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name" readonly="1" force_save="1"/>
                                        <field name="state"/>
                                        <field name="observation"/>
                                        <field name="repaired"/>
                                        <field name="template_id" column_invisible="1" force_save="1"/>
                                        <field name="template_line_id" column_invisible="1" force_save="1"/>
                                        <field name="checklist_type" column_invisible="1" force_save="1"/>
                                    </list>
                                </field>
                            </page>
                            <page name="checklist" string="Service Repair Checklist">
                                <group>
                                    <field name="repair_checklist_ids" colspan="2" nolabel="1"
                                           options="{'no_create': True}">
                                    </field>
                                </group>
                            </page>
                            <page name="review_and_rating" string="Review and Ratings">
                                <group>
                                    <field name="feedback_description"/>
                                    <field name="rating" widget="priority"/>
                                </group>
                            </page>
                            <page string="Timesheet" invisible="1">
                                <field name="timesheet_ids" widget="one2many_list">
                                    <list string="Timesheet" editable="bottom">
                                        <field name="repair_id" column_invisible="1"/>
                                        <field name="date"/>
                                        <field name="project_id" string="Service Name"/>
                                        <field name="name"/>
                                        <field name="service_type" required="1" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="unit_amount" string="Duration (Hours)" widget="timesheet_uom"
                                               sum="Total"/>
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="account_id" required="False" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>

                            <page name="road_tests" string="Pruebas de ruta"
                                  groups="car_repair_industry.group_fleet_repair_service_manager,car_repair_industry.group_fleet_repair_directeur_commercial,car_repair_industry.group_fleet_repair_portal_road_test">
                                <field name="road_test_ids">
                                    <list string="Pruebas de ruta"
                                          decoration-success="state == 'done'"
                                          decoration-info="state == 'assigned'"
                                          decoration-warning="state == 'in_progress'"
                                          decoration-muted="state == 'cancelled'">
                                        <field name="test_type"/>
                                        <field name="requested_by_id"/>
                                        <field name="requested_at"/>
                                        <field name="driver_id" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="state" widget="badge"
                                               decoration-muted="state == 'requested'"
                                               decoration-info="state == 'assigned'"
                                               decoration-warning="state == 'in_progress'"
                                               decoration-success="state == 'done'"
                                               decoration-danger="state == 'cancelled'"/>
                                        <field name="km_start" optional="hide"/>
                                        <field name="km_end" optional="hide"/>
                                        <field name="completed_at" optional="show"/>
                                        <button name="action_assign" string="Asignar" type="object"
                                                icon="fa-user-plus" class="btn-sm btn-info"
                                                invisible="state != 'requested'"
                                                groups="car_repair_industry.group_fleet_repair_service_manager,car_repair_industry.group_fleet_repair_directeur_commercial"/>
                                        <button name="action_done" string="Finalizar" type="object"
                                                icon="fa-check" class="btn-sm btn-success"
                                                invisible="state != 'in_progress'"
                                                groups="car_repair_industry.group_fleet_repair_service_manager,car_repair_industry.group_fleet_repair_directeur_commercial"/>
                                    </list>
                                </field>
                            </page>

                            <page name="spare_requests" string="Repuestos solicitados"
                                  groups="car_repair_industry.group_fleet_repair_spare_warehouse,car_repair_industry.group_fleet_repair_service_manager,base.group_system">
                                <field name="spare_request_ids" readonly="1">
                                    <list string="Solicitudes de repuestos"
                                          decoration-info="state == 'requested'"
                                          decoration-success="state == 'reviewed'"
                                          decoration-muted="state == 'cancelled'">
                                        <field name="request_date" string="Fecha"/>
                                        <field name="requested_by_id" string="Técnico"/>
                                        <field name="line_count" string="# Repuestos"/>
                                        <field name="state" widget="badge"
                                               decoration-info="state == 'requested'"
                                               decoration-success="state == 'reviewed'"
                                               decoration-danger="state == 'cancelled'"/>
                                        <field name="warehouse_note" string="Obs. almacén" optional="show"/>
                                        <button name="action_mark_reviewed"
                                                string="Marcar revisada"
                                                type="object"
                                                icon="fa-check"
                                                class="btn-sm btn-success"
                                                invisible="state != 'requested'"
                                                groups="car_repair_industry.group_fleet_repair_spare_warehouse,car_repair_industry.group_fleet_repair_service_manager,base.group_system"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!--fleet Repair Tree View-->

        <record id="view_fleet_repair_tree" model="ir.ui.view">
            <field name="name">fleet.repair.list</field>
            <field name="model">fleet.repair</field>
            <field name="priority">4</field>
            <field name="arch" type="xml">
                <list string="Car Repair">
                    <field name="sequence"/>
                    <field name="name" string="Descripción"/>
                    <field name="client_id"/>
                    <field name="license_plate" string="Placa"/>
                    <field name="vehicle_brand_id" string="Marca" optional="show"/>
                    <field name="phone" optional="show"/>
                    <field name="receipt_date"/>
                    <field name="state"
                        optional="show"
                        widget="badge"
                        decoration-info="state in ('draft', 'diagnosis')"
                        decoration-warning="state in ('quote', 'saleorder', 'workorder')"
                        decoration-success="state in ('work_completed', 'invoiced', 'done')"
                        decoration-danger="state == 'cancel'"/>
                    <field name="priority" optional="hide" widget="badge" decoration-info="priority == '1'" decoration-danger="priority == '2'" />
                    <field name="user_id" optional="hide"/>
                    <field name="portal_technician_id" string="Técnico"/>
                </list>
            </field>
        </record>


        <record id="view_repair_order_filter" model="ir.ui.view">
            <field name="name">fleet.repair.list.select</field>
            <field name="model">fleet.repair</field>
            <field name="arch" type="xml">
                <search string="Search Repair Order">
                    <field name="sequence"/>
                    <field name="name" string="Repair Order"/>
                    <field name="client_id" operator="child_of"/>
                    <field name="user_id"/>
                    <field name="fleet_id"/>
                    <filter name="state_open"
                            string="Pendientes"
                            domain="[('state', 'in', ('draft','diagnosis','diagnosis_complete','quote','saleorder','workorder'))]"/>
                    <filter name="state_done"
                            string="Completadas"
                            domain="[('state', 'in', ('work_completed','invoiced','done'))]"/>
                    <filter name="state_cancel"
                            string="Canceladas"
                            domain="[('state', '=', 'cancel')]"/>

                    <separator/>

                    <filter name="priority_low"
                            string="Prioridad baja"
                            domain="[('priority', '=', '0')]"/>
                    <filter name="priority_normal"
                            string="Prioridad  media"
                            domain="[('priority', '=', '1')]"/>
                    <filter name="priority_high"
                            string="Prioridad  alta"
                            domain="[('priority', '=', '2')]"/>

                    <group expand="0" string="Agrupar por">
                        <filter name="group_by_client"
                                string="Cliente"
                                context="{'group_by': 'client_id'}"/>
                        <filter name="group_by_state"
                                string="Estado"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_by_user"
                                string="Asignado a"
                                context="{'group_by': 'user_id'}"/>
                        <filter name="group_by_receipt_date"
                                string="Fecha de recibo"
                                context="{'group_by': 'receipt_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!--Action-->
        <record model="ir.actions.act_window" id="action_fleet_repair_tree_view">
            <field name="name">Car Repair</field>
            <field name="res_model">fleet.repair</field>

            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_repair_order_filter"/>
            <field name="view_id" ref="view_fleet_repair_tree"/>
        </record>

        <!--Menuitems-->
        <menuitem id="menu_main_car_repair" name="Taller de autos" sequence="50"
                  web_icon="car_repair_industry,static/description/icon.png"/>
        <menuitem name="Car Repair" parent="menu_main_car_repair" id="menu_sub_car_repair" sequence="3"/>

        <menuitem name="Car Repair" parent="menu_sub_car_repair" id="menu_fleet_repair_submenu" sequence="3"
                  action="action_fleet_repair_tree_view"/>


        <!-- service type -->
        <record id="service_type_form_view" model="ir.ui.view">
            <field name="name">service.type.form.view</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet string="Service Types">
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="service_type_tree_view" model="ir.ui.view">
            <field name="name">service.type.list.view</field>
            <field name="model">service.type</field>
            <field name="arch" type="xml">
                <list string="Service Type" editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_service_type" model="ir.actions.act_window">
            <field name="name">Service Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">service.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Service Type" parent="menu_sub_car_repair" id="menu_service_type" sequence="11"
                  action="action_service_type"/>
        <!-- fleet Lines-->

        <record id="view_repair_fleet_line_form" model="ir.ui.view">
            <field name="name">fleet.repair.line.form</field>
            <field name="model">fleet.repair.line</field>
            <field name="arch" type="xml">
                <form string="fleet Lines">
                    <header>
                        <button name="action_add_fleet_diagnosis_result" string="Enter Results" type="object"
                                class="oe_highlight" style="float:left;"
                                invisible="(diagnose_id == False) or (state in ['done', 'draft'])"
                                groups="car_repair_industry.group_fleet_repair_head_technician,car_repair_industry.group_fleet_repair_directeur_commercial,car_repair_industry.group_fleet_repair_service_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,diagnosis,done"/>
                    </header>
                    <sheet>
                        <group class="col-xs-12">
                            <group class="col-xs-6">
                                <field name="fleet_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="license_plate" readonly="1"/>
                                <field name="vin_sn" readonly="1"/>
                                <field name="engine_number" readonly="1"/>
                            </group>
                            <group class="col-xs-6">
                                <field name="model_id" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                                <field name="fuel_type" readonly="1"/>
                                <field name="car_year"/>
                                <field name="diagnose_id" invisible="True"/>
                                <field name="workorder_id" invisible="True"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Service Details">
                                <group>
                                    <group>
                                        <field name="guarantee" widget="radio" readonly="state != 'draft'"/>
                                        <field name="guarantee_type" widget="radio" invisible="guarantee == 'no'"
                                               readonly="state != 'draft'"/>
                                    </group>
                                    <group>
                                        <field name="service_type" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                                    </group>
                                </group>
                                <group>
                                    <group>
                                        <separator string="Service Details"/>
                                        <field name="service_detail" readonly="state != 'draft'" string=""/>
                                    </group>
                                    <group>
                                        <separator string="List of Damage"/>
                                        <field name="list_of_damage" readonly="state != 'draft'" string=""/>
                                    </group>
                                </group>
                            </page>
                            <page string="Diagnosis Report" invisible="(diagnose_id == False) or (state != 'done')">
                                <group>

                                    <group invisible="guarantee_type == 'free'">
                                        <field name="est_ser_hour" readonly="workorder_id != False"/>
                                    </group>
                                    <group invisible="guarantee_type == 'free'">
                                        <field name="warehouse_id" options="{'no_create': True, 'no_open': True}" readonly="workorder_id != False"/>
                                    </group>
                                </group>
                                <separator string="PIEZAS DE RECAMBIO / SERVICIO ADICIONAL"/>
                                <field name="spare_part_ids" readonly="workorder_id != False">
                                    <list string="Spare Parts" editable="bottom">
                                        <field name="product_id" domain="[('type', 'in', ['service','consu'])]"/>
                                        <field name="default_code"/>
                                        <field name="quantity"/>
                                        <!-- <field name="price_unit"/> -->
                                    </list>
                                </field>
                                <separator string="Diagnostic Results"/>
                                <field name="diagnostic_result" readonly="workorder_id != False"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_repair_fleet_line_tree" model="ir.ui.view">
            <field name="name">repair.fleet.line.list</field>
            <field name="model">fleet.repair.line</field>
            <field name="priority">4</field>
            <field name="arch" type="xml">
                <list string="fleet Lines">
                    <field name="fleet_id"/>
                    <field name="license_plate"/>
                    <field name="model_id"/>
                    <field name="vin_sn"/>
                    <field name="fuel_type"/>
                    <field name="car_year"/>
                    <field name="guarantee" widget="radio"/>
                    <field name="service_type"/>
                    <field name="tecnico_status"
                        widget="badge"
                        string="Avance técnico"
                        decoration-muted="tecnico_status == 'pendiente'"
                        decoration-warning="tecnico_status == 'en_progreso'"
                        decoration-success="tecnico_status == 'completado'"/>
                    <field name="tecnico_notes" string="Notas técnico" optional="show"/>
                    <field name="state"
                        widget="badge"
                        decoration-info="state == 'draft'"
                        decoration-warning="state == 'diagnosis'"
                        decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

    </data>
</odoo>
