<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_car_repair_portal_profile" model="ir.ui.view">
        <field name="name">res.users.form.car.repair.portal.profile</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']//group[1]" position="after">
                <group string="Taller de autos" groups="base.group_system">
                    <field name="car_repair_portal_profile" widget="radio"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
