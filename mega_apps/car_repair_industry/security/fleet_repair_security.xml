<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Categoría de permisos Odoo 18 -->
        <record id="module_category_fleet_repair" model="ir.module.category">
            <field name="name">Taller de autos</field>
            <field name="description">Permisos del módulo de taller de autos.</field>
            <field name="parent_id" ref="base.module_category_services"/>
            <field name="visible" eval="True"/>
            <field name="sequence">3</field>
        </record>

        <!-- Grupos -->
        <record id="group_fleet_repair_technician" model="res.groups">
            <field name="name">Técnico</field>
            <field name="category_id" ref="car_repair_industry.module_category_fleet_repair"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_fleet_repair_head_technician" model="res.groups">
            <field name="name">Técnico principal</field>
            <field name="category_id" ref="car_repair_industry.module_category_fleet_repair"/>
            <field name="implied_ids" eval="[(4, ref('car_repair_industry.group_fleet_repair_technician'))]"/>
        </record>

        <record id="group_fleet_repair_service_manager" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="car_repair_industry.module_category_fleet_repair"/>
            <field name="implied_ids" eval="[(4, ref('car_repair_industry.group_fleet_repair_head_technician'))]"/>
        </record>

        <record id="group_fleet_repair_directeur_commercial" model="res.groups">
            <field name="name">Director Comercial</field>
            <field name="category_id" ref="car_repair_industry.module_category_fleet_repair"/>
            <field name="implied_ids" eval="[
                (4, ref('car_repair_industry.group_fleet_repair_service_manager')),
                (4, ref('sales_team.group_sale_manager'))
            ]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_fleet_repair_portal_advisor" model="res.groups">
            <field name="name">Portal - Asesor recepción</field>
            <field name="category_id" ref="car_repair_industry.module_category_fleet_repair"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_fleet_repair_portal_technician" model="res.groups">
            <field name="name">Portal - Técnico</field>
            <field name="category_id" ref="car_repair_industry.module_category_fleet_repair"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_fleet_repair_portal_road_test" model="res.groups">
            <field name="name">Portal - Prueba de ruta</field>
            <field name="category_id" ref="car_repair_industry.module_category_fleet_repair"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Los administradores de Ajustes deben poder ingresar al módulo en instalaciones limpias. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('car_repair_industry.group_fleet_repair_directeur_commercial'))]"/>
        </record>

        <!-- Reglas técnico -->
        <record id="car_repair_rule_user" model="ir.rule">
            <field name="name">Órdenes de reparación - Técnico</field>
            <field name="model_id" ref="model_fleet_repair"/>
            <field name="global" eval="False"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_technician'))]"/>
        </record>

        <record id="car_repair_rule_user_diagnosis" model="ir.rule">
            <field name="name">Diagnósticos - Técnico</field>
            <field name="model_id" ref="model_fleet_diagnose"/>
            <field name="global" eval="False"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_technician'))]"/>
        </record>

        <record id="car_repair_rule_user_work_order" model="ir.rule">
            <field name="name">Órdenes de trabajo - Técnico</field>
            <field name="model_id" ref="model_fleet_workorder"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_technician'))]"/>
        </record>

        <!-- Reglas técnico principal -->
        <record id="car_repair_rule_head_technician" model="ir.rule">
            <field name="name">Órdenes de reparación - Técnico principal</field>
            <field name="model_id" ref="model_fleet_repair"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_head_technician'))]"/>
        </record>

        <record id="car_repair_head_technician_diagnosis" model="ir.rule">
            <field name="name">Diagnósticos - Técnico principal</field>
            <field name="model_id" ref="model_fleet_diagnose"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_head_technician'))]"/>
        </record>

        <record id="car_repair_rule_head_technician_work_order" model="ir.rule">
            <field name="name">Órdenes de trabajo - Técnico principal</field>
            <field name="model_id" ref="model_fleet_workorder"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_head_technician'))]"/>
        </record>

        <!-- Reglas supervisor -->
        <record id="car_repair_rule_service_manager" model="ir.rule">
            <field name="name">Órdenes de reparación - Supervisor</field>
            <field name="model_id" ref="model_fleet_repair"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_service_manager'))]"/>
        </record>

        <record id="car_repair_rule_service_manager_diagnosis" model="ir.rule">
            <field name="name">Diagnósticos - Supervisor</field>
            <field name="model_id" ref="model_fleet_diagnose"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_service_manager'))]"/>
        </record>

        <record id="car_repair_rule_service_manager_work_order" model="ir.rule">
            <field name="name">Órdenes de trabajo - Supervisor</field>
            <field name="model_id" ref="model_fleet_workorder"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_service_manager'))]"/>
        </record>

        <!-- Reglas director comercial -->
        <record id="car_repair_rule_directeur_commercial" model="ir.rule">
            <field name="name">Órdenes de reparación - Director Comercial</field>
            <field name="model_id" ref="model_fleet_repair"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_directeur_commercial'))]"/>
        </record>

        <record id="car_repair_rule_directeur_commercial_diagnosis" model="ir.rule">
            <field name="name">Diagnósticos - Director Comercial</field>
            <field name="model_id" ref="model_fleet_diagnose"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_directeur_commercial'))]"/>
        </record>

        <record id="car_repair_rule_directeur_commercial_work_order" model="ir.rule">
            <field name="name">Órdenes de trabajo - Director Comercial</field>
            <field name="model_id" ref="model_fleet_workorder"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_directeur_commercial'))]"/>
        </record>

        <!-- Reglas portal -->
        <record id="car_repair_rule_portal_advisor_repair" model="ir.rule">
            <field name="name">Portal asesor - sus órdenes</field>
            <field name="model_id" ref="model_fleet_repair"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('portal_advisor_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_portal_advisor'))]"/>
        </record>

        <record id="car_repair_rule_portal_technician_repair" model="ir.rule">
            <field name="name">Portal técnico - órdenes asignadas</field>
            <field name="model_id" ref="model_fleet_repair"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('portal_technician_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_portal_technician'))]"/>
        </record>

        <record id="car_repair_rule_portal_road_test_repair" model="ir.rule">
            <field name="name">Portal prueba ruta - órdenes asignadas</field>
            <field name="model_id" ref="model_fleet_repair"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('road_test_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('car_repair_industry.group_fleet_repair_portal_road_test'))]"/>
        </record>

    </data>
</odoo>
