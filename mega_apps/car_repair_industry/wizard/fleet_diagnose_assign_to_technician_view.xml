<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_fleet_diagnose_assign_to_tech_form" model="ir.ui.view">
            <field name="name">fleet.diagnose.assignto.tech.form</field>
            <field name="model">fleet.diagnose.assignto.technician</field>
            <field name="arch" type="xml">
                <form string="Asignación de técnico">
                    <group>
                        <field name="is_reassignment" invisible="1"/>
                        <field name="available_technician_ids" invisible="1"/>
                        <field name="current_user_id"
                               string="Técnico actual"
                               readonly="1"
                               invisible="not is_reassignment"/>
                        <field name="user_id"
                               string="Nuevo técnico"
                               options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', available_technician_ids)]"/>
                        <field name="reassign_reason"
                               string="Motivo de reasignación"
                               invisible="not is_reassignment"
                               required="is_reassignment"
                               placeholder="Ej: Incapacidad, Accidente, Cambio de turno..."/>
                    </group>
                    <footer>
                        <button name="do_assign_technician"
                                string="Confirmar"
                                type="object"
                                class="oe_highlight"/>
                        or
                        <button string="Cancelar"
                                class="oe_link"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_fleet_diagnose_assign_to_technician" model="ir.actions.act_window">
            <field name="name">Asignación de técnico</field>
            <field name="res_model">fleet.diagnose.assignto.technician</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_fleet_diagnose_assign_to_tech_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
