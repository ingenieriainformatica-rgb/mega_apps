<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Muestra el campo administrado por código mega_concepto en el formulario
         estándar de account.move. No toca la vista de Studio
         (studio_customization.odoo_studio_account__...) que sigue mostrando
         x_studio_concepto de forma independiente. -->
    <record id="view_move_form_inherit_mega_concepto" model="ir.ui.view">
        <field name="name">account.move.form.inherit.mega.concepto</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="mega_concepto"/>
            </xpath>
        </field>
    </record>

    <!-- Muestra mega_descripcion_general junto a mega_concepto. Se ancla en
         'ref' (campo núcleo de account.move, siempre presente) y no en el
         campo de Studio x_studio_descripcin_1: ese campo solo existe en el
         árbol de vista combinado una vez que la vista de Studio (priority
         160) se aplica, algo que NO ha ocurrido todavía cuando esta vista
         se carga durante una actualización completa de módulos (-u sin
         nombre, o "Actualizar" general) -verificado con un reload completo
         del registro-, así que anclar ahí rompe cualquier actualización. -->
    <record id="view_move_form_inherit_mega_descripcion_general" model="ir.ui.view">
        <field name="name">account.move.form.inherit.mega.descripcion.general</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mega_concepto']" position="after">
                <field name="mega_descripcion_general"/>
            </xpath>
        </field>
    </record>
</odoo>
