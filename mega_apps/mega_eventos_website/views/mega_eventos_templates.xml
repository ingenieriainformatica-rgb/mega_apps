<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_mega_eventos_landing" name="Mega Eventos">
        <html lang="es">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Eventos Mega</title>
                <meta name="description" content="Conoce los próximos eventos y actívate con las novedades de Mega."/>
                <style>
                    * { box-sizing: border-box; }
                    :root {
                        --mega-ink: #071426;
                        --mega-dark-tile: #0f172a;
                        --mega-brand-green: #10b981;
                        --mega-ring: rgba(0, 0, 0, 0.10);
                        --mega-muted: #647084;
                    }
                    body {
                        margin: 0;
                        min-height: 100vh;
                        display: flex;
                        flex-direction: column;
                        font-family: Arial, Helvetica, sans-serif;
                        color: var(--mega-ink);
                        background: #ffffff;
                    }
                    body > footer {
                        margin-top: auto;
                    }
                    .mega-eventos-brand-header {
                        display: grid;
                        place-items: center;
                        padding: 10px 16px;
                        background: var(--mega-brand-green);
                    }
                    .mega-eventos-brand-header__card {
                        display: grid;
                        place-items: center;
                        width: 100%;
                        max-width: 820px;
                        min-height: 60px;
                        padding: 8px 12px;
                        border-radius: 12px;
                        outline: 1px solid var(--mega-ring);
                        background: rgba(255, 255, 255, 0.95);
                    }
                    .mega-eventos-brand-header__logo {
                        display: block;
                        max-height: 60px;
                        width: auto;
                        max-width: 100%;
                        object-fit: contain;
                    }
                    @media (max-width: 640px) {
                        .mega-eventos-brand-header__logo { max-height: 46px; }
                    }

                    .mega-eventos-promo {
                        padding: 48px 16px 56px;
                        background-image:
                            linear-gradient(180deg, rgba(244, 250, 248, 0.12) 0%, rgba(255, 255, 255, 0.25) 100%),
                            url("/mega_eventos_website/static/src/img/banner-corporativo.jpg");
                        background-size: cover, cover;
                        background-position: center top, center 30%;
                        background-repeat: no-repeat, no-repeat;
                    }
                    .mega-eventos-intro {
                        max-width: 620px;
                        margin: 0 auto 40px;
                        padding: 22px 28px;
                        border-radius: 18px;
                        background: rgba(255, 255, 255, 0.88);
                        box-shadow: 0 8px 24px rgba(7, 20, 38, 0.10);
                        text-align: center;
                    }
                    .mega-eventos-intro__title {
                        margin: 0 0 12px;
                        font-size: clamp(24px, 3.4vw, 32px);
                        font-weight: 800;
                        letter-spacing: -0.3px;
                        color: var(--mega-ink);
                    }
                    .mega-eventos-intro__text {
                        margin: 0;
                        font-size: 16px;
                        line-height: 1.55;
                        font-weight: 600;
                        color: #3a4a5c;
                    }
                    .mega-eventos-promo__grid {
                        width: 100%;
                        max-width: 820px;
                        margin: 0 auto;
                        display: grid;
                        grid-template-columns: 1fr;
                        gap: 26px;
                    }
                    .mega-eventos-tile {
                        position: relative;
                        display: flex;
                        align-items: center;
                        gap: 24px;
                        text-align: left;
                        padding: 28px 32px;
                        border-radius: 18px;
                        box-shadow: 0 8px 20px rgba(7, 20, 38, 0.10);
                        outline: 1px solid rgba(0, 0, 0, 0.06);
                        transition: transform 0.18s ease, box-shadow 0.18s ease;
                    }
                    .mega-eventos-tile:hover {
                        transform: translateY(-5px);
                        box-shadow: 0 20px 36px rgba(7, 20, 38, 0.18);
                    }
                    .mega-eventos-tile--light {
                        background: #ffffff;
                        color: var(--mega-ink);
                    }
                    .mega-eventos-tile--dark {
                        background: var(--mega-dark-tile);
                        color: #ffffff;
                        outline-color: rgba(0, 0, 0, 0.25);
                    }
                    .mega-eventos-tile__badge {
                        position: absolute;
                        top: -14px;
                        right: 24px;
                        background: var(--mega-brand-green);
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 0.3px;
                        padding: 7px 16px;
                        border-radius: 999px;
                        box-shadow: 0 8px 16px rgba(16, 185, 129, 0.35);
                    }
                    .mega-eventos-tile__icon-badge {
                        display: grid;
                        place-items: center;
                        flex: 0 0 auto;
                        width: 78px;
                        height: 78px;
                        border-radius: 50%;
                    }
                    .mega-eventos-tile--light .mega-eventos-tile__icon-badge {
                        background: rgba(16, 185, 129, 0.10);
                    }
                    .mega-eventos-tile--dark .mega-eventos-tile__icon-badge {
                        background: rgba(255, 255, 255, 0.12);
                    }
                    .mega-eventos-tile__icon {
                        display: block;
                        width: 40px;
                        height: 40px;
                        object-fit: contain;
                    }
                    /* icons/oil.svg and icons/battery.svg are drawn in dark ink; invert to white on a dark tile */
                    .mega-eventos-tile--dark .mega-eventos-tile__icon--ink {
                        filter: brightness(0) invert(1);
                    }
                    /* icons/tools.svg and icons/maintenance.svg are drawn in white; force to dark ink on a light tile */
                    .mega-eventos-tile--light .mega-eventos-tile__icon--paper {
                        filter: brightness(0);
                    }
                    .mega-eventos-tile__content {
                        display: flex;
                        flex-direction: column;
                        align-items: flex-start;
                        gap: 14px;
                        flex: 1 1 auto;
                        min-width: 0;
                    }
                    .mega-eventos-tile__title {
                        margin: 0;
                        font-weight: 800;
                        line-height: 1.3;
                        font-size: 21px;
                        letter-spacing: -0.2px;
                    }
                    .mega-eventos-tile__cta {
                        appearance: none;
                        border: 0;
                        font-weight: 700;
                        font-size: 14px;
                        padding: 10px 24px;
                        border-radius: 999px;
                        cursor: pointer;
                        transition: transform 0.12s ease, box-shadow 0.12s ease;
                    }
                    .mega-eventos-tile--light .mega-eventos-tile__cta {
                        background: var(--mega-brand-green);
                        color: #ffffff;
                        box-shadow: 0 8px 16px rgba(16, 185, 129, 0.32);
                    }
                    .mega-eventos-tile--dark .mega-eventos-tile__cta {
                        background: #ffffff;
                        color: var(--mega-dark-tile);
                        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.28);
                    }
                    .mega-eventos-tile__cta:hover {
                        transform: translateY(-2px);
                    }

                    .mega-eventos-promo__legal {
                        display: table;
                        margin: 26px auto 0;
                        padding: 6px 16px;
                        border-radius: 999px;
                        background: rgba(255, 255, 255, 0.85);
                        color: #3a4a5c;
                        font-weight: 600;
                        text-align: center;
                        font-size: 12px;
                    }

@media (max-width: 640px) {
                        .mega-eventos-tile { padding: 22px 20px; gap: 16px; }
                        .mega-eventos-tile__icon-badge { width: 58px; height: 58px; }
                        .mega-eventos-tile__icon { width: 30px; height: 30px; }
                        .mega-eventos-tile__title { font-size: 17px; }
                        .mega-eventos-tile__badge { top: -12px; right: 16px; font-size: 11px; padding: 6px 12px; }
                    }

                    .mega-eventos-footer__logo {
                        display: block;
                        max-height: 48px;
                        width: auto;
                        max-width: 100%;
                        object-fit: contain;
                        margin: 0 auto 6px;
                    }
                    .mega-eventos-footer__text {
                        margin: 0;
                        color: var(--mega-ink);
                        font-size: 14px;
                        font-weight: 600;
                        text-align: center;
                    }

                    /* Modal de inscripción */
                    .mega-eventos-modal-overlay {
                        position: fixed;
                        inset: 0;
                        z-index: 1000;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        padding: 20px;
                        background: rgba(7, 20, 38, 0.55);
                    }
                    .mega-eventos-modal-overlay[hidden] { display: none; }
                    .mega-eventos-modal {
                        position: relative;
                        width: 100%;
                        max-width: 560px;
                        max-height: 90vh;
                        overflow-y: auto;
                        background: #ffffff;
                        border-radius: 14px;
                        padding: 28px;
                        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.32);
                    }
                    .mega-eventos-modal__close {
                        position: absolute;
                        top: 14px;
                        right: 14px;
                        border: 0;
                        background: transparent;
                        font-size: 24px;
                        line-height: 1;
                        cursor: pointer;
                        color: var(--mega-muted);
                    }
                    .mega-eventos-modal__title {
                        margin: 0 0 6px;
                        font-size: 22px;
                        color: var(--mega-ink);
                    }
                    .mega-eventos-modal__subtitle {
                        margin: 0 0 18px;
                        font-size: 14px;
                        color: var(--mega-muted);
                    }
                    .mega-eventos-modal__alert {
                        margin: 0 0 16px;
                        padding: 10px 14px;
                        border-radius: 8px;
                        font-size: 14px;
                    }
                    .mega-eventos-modal__alert--error {
                        background: #fff3f3;
                        border: 1px solid #f0b8b8;
                        color: #9b1c1c;
                    }
                    .mega-eventos-modal__alert--success {
                        background: #ecfdf5;
                        border: 1px solid #a7f0d3;
                        color: #05683f;
                    }
                    .mega-eventos-modal__form {
                        display: grid;
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                        gap: 14px;
                    }
                    .mega-eventos-field { display: flex; flex-direction: column; gap: 6px; }
                    .mega-eventos-field--wide { grid-column: 1 / -1; }
                    .mega-eventos-field label { font-size: 13px; font-weight: 700; color: var(--mega-ink); }
                    .mega-eventos-field input {
                        min-height: 42px;
                        border: 1px solid #cbd6e4;
                        border-radius: 6px;
                        padding: 8px 12px;
                        font-size: 14px;
                        font-family: inherit;
                    }
                    .mega-eventos-field input.js-mega-eventos-uppercase {
                        text-transform: uppercase;
                    }
                    .mega-eventos-field input:focus {
                        outline: none;
                        border-color: var(--mega-brand-green);
                        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
                    }
                    .mega-eventos-check {
                        grid-column: 1 / -1;
                        display: flex;
                        gap: 10px;
                        align-items: flex-start;
                        font-size: 13px;
                        line-height: 1.4;
                        color: var(--mega-ink);
                    }
                    .mega-eventos-check input { margin-top: 3px; width: 16px; height: 16px; flex: 0 0 auto; }
                    .mega-eventos-check a { color: var(--mega-brand-green); font-weight: 700; }
                    .mega-eventos-modal__actions {
                        grid-column: 1 / -1;
                        display: flex;
                        gap: 12px;
                        margin-top: 4px;
                    }
                    .mega-eventos-modal__submit {
                        flex: 1 1 auto;
                        min-height: 46px;
                        border: 0;
                        border-radius: 6px;
                        background: var(--mega-brand-green);
                        color: #ffffff;
                        font-weight: 700;
                        font-size: 15px;
                        cursor: pointer;
                    }
                    .mega-eventos-modal__submit:disabled { opacity: 0.6; cursor: not-allowed; }
                    .mega-eventos-modal__cancel {
                        min-height: 46px;
                        padding: 0 20px;
                        border: 1px solid #cbd6e4;
                        border-radius: 6px;
                        background: #ffffff;
                        color: var(--mega-ink);
                        font-weight: 700;
                        cursor: pointer;
                    }
                    @media (max-width: 640px) {
                        .mega-eventos-modal__form { grid-template-columns: 1fr; }
                        .mega-eventos-modal { padding: 22px; }
                    }

                    .mega-eventos-modal__success {
                        text-align: center;
                        padding: 12px 0 4px;
                    }
                    .mega-eventos-modal__success[hidden] { display: none; }
                    .mega-eventos-modal__success-icon {
                        display: inline-grid;
                        place-items: center;
                        width: 64px;
                        height: 64px;
                        margin: 0 auto 16px;
                        border-radius: 50%;
                        background: var(--mega-brand-green);
                        color: #ffffff;
                        font-size: 32px;
                        font-weight: 800;
                    }
                    .mega-eventos-modal__success-title {
                        margin: 0 0 10px;
                        font-size: 22px;
                        color: var(--mega-ink);
                    }
                    .mega-eventos-modal__success-code {
                        margin: 0 0 14px;
                        font-size: 15px;
                        color: var(--mega-ink);
                    }
                    .mega-eventos-modal__success-code strong {
                        color: #05683f;
                        background: #ecfdf5;
                        border: 1px solid #a7f0d3;
                        border-radius: 6px;
                        padding: 2px 10px;
                    }
                    .mega-eventos-modal__success-text {
                        margin: 0 0 22px;
                        font-size: 15px;
                        line-height: 1.5;
                        color: #354157;
                    }
                </style>
            </head>
            <body>
                <header class="mega-eventos-brand-header">
                    <div class="mega-eventos-brand-header__card">
                        <img
                            class="mega-eventos-brand-header__logo"
                            src="/mega_eventos_website/static/src/img/megatecnicentro-logo.svg"
                            alt="Mega Tecnicentro"
                        />
                    </div>
                </header>

                <section class="mega-eventos-promo">
                    <div class="mega-eventos-intro">
                        <h1 class="mega-eventos-intro__title">Activa tus beneficios Mega</h1>
                        <p class="mega-eventos-intro__text">
                            Elige el beneficio que quieres reclamar e inscríbete en segundos.
                            Nuestro equipo se pondrá en contacto para agendar tu cita.
                        </p>
                    </div>

                    <div class="mega-eventos-promo__grid">
                        <div class="mega-eventos-tile mega-eventos-tile--dark">
                            <span class="mega-eventos-tile__badge">10% OFF</span>
                            <div class="mega-eventos-tile__icon-badge">
                                <img class="mega-eventos-tile__icon mega-eventos-tile__icon--ink" src="/mega_eventos_website/static/src/img/icons/oil.svg" alt=""/>
                            </div>
                            <div class="mega-eventos-tile__content">
                                <p class="mega-eventos-tile__title">10% cambio de aceite</p>
                                <button
                                    type="button"
                                    class="mega-eventos-tile__cta js-mega-eventos-open"
                                    data-service="eventos_cambio_aceite"
                                    data-label="10% cambio de aceite"
                                >Inscribirme</button>
                            </div>
                        </div>

                        <div class="mega-eventos-tile mega-eventos-tile--light">
                            <span class="mega-eventos-tile__badge">10% OFF</span>
                            <div class="mega-eventos-tile__icon-badge">
                                <img class="mega-eventos-tile__icon mega-eventos-tile__icon--paper" src="/mega_eventos_website/static/src/img/icons/tools.svg" alt=""/>
                            </div>
                            <div class="mega-eventos-tile__content">
                                <p class="mega-eventos-tile__title">10% trabajos autorizados</p>
                                <button
                                    type="button"
                                    class="mega-eventos-tile__cta js-mega-eventos-open"
                                    data-service="trabajos_autorizados"
                                    data-label="10% trabajos autorizados"
                                >Inscribirme</button>
                            </div>
                        </div>

                        <div class="mega-eventos-tile mega-eventos-tile--dark">
                            <span class="mega-eventos-tile__badge">70% OFF</span>
                            <div class="mega-eventos-tile__icon-badge">
                                <img class="mega-eventos-tile__icon mega-eventos-tile__icon--paper" src="/mega_eventos_website/static/src/img/icons/maintenance.svg" alt=""/>
                            </div>
                            <div class="mega-eventos-tile__content">
                                <p class="mega-eventos-tile__title">70% en MegaCombo 7 servicios</p>
                                <button
                                    type="button"
                                    class="mega-eventos-tile__cta js-mega-eventos-open"
                                    data-service="eventos_mega_combo"
                                    data-label="70% en MegaCombo 7 servicios"
                                >Inscribirme</button>
                            </div>
                        </div>

                        <div class="mega-eventos-tile mega-eventos-tile--light">
                            <span class="mega-eventos-tile__badge">GRATIS</span>
                            <div class="mega-eventos-tile__icon-badge">
                                <img class="mega-eventos-tile__icon mega-eventos-tile__icon--ink" src="/mega_eventos_website/static/src/img/icons/battery.svg" alt=""/>
                            </div>
                            <div class="mega-eventos-tile__content">
                                <p class="mega-eventos-tile__title">Revisión GRATIS de batería</p>
                                <button
                                    type="button"
                                    class="mega-eventos-tile__cta js-mega-eventos-open"
                                    data-service="revision_bateria"
                                    data-label="Revisión GRATIS de batería"
                                >Inscribirme</button>
                            </div>
                        </div>
                    </div>
                    <div class="mega-eventos-promo__legal">Fechas y cupos sujetos a confirmación*</div>
                </section>

                <div id="mega-eventos-modal-overlay" class="mega-eventos-modal-overlay" hidden="hidden">
                    <div class="mega-eventos-modal" role="dialog" aria-modal="true" aria-labelledby="mega-eventos-modal-title">
                        <button type="button" class="mega-eventos-modal__close" id="mega-eventos-modal-close" aria-label="Cerrar">&#215;</button>
                        <h2 id="mega-eventos-modal-title" class="mega-eventos-modal__title">Inscribirme</h2>
                        <p class="mega-eventos-modal__subtitle">Estás solicitando: <strong id="mega-eventos-modal-benefit"></strong></p>

                        <div id="mega-eventos-modal-alert" class="mega-eventos-modal__alert" hidden="hidden"></div>

                        <form id="mega-eventos-modal-form" class="mega-eventos-modal__form">
                            <input type="hidden" name="service_acquired" id="mega-eventos-field-service"/>
                            <div class="mega-eventos-field">
                                <label for="mega-eventos-field-name">Nombre completo *</label>
                                <input id="mega-eventos-field-name" name="name" type="text" class="js-mega-eventos-uppercase" required="required"/>
                            </div>
                            <div class="mega-eventos-field">
                                <label for="mega-eventos-field-vat">Cédula *</label>
                                <input id="mega-eventos-field-vat" name="vat" type="text" required="required"/>
                            </div>
                            <div class="mega-eventos-field">
                                <label for="mega-eventos-field-phone">Teléfono *</label>
                                <input id="mega-eventos-field-phone" name="phone" type="tel" required="required"/>
                            </div>
                            <div class="mega-eventos-field">
                                <label for="mega-eventos-field-email">Correo electrónico *</label>
                                <input id="mega-eventos-field-email" name="email" type="email" required="required"/>
                            </div>
                            <div class="mega-eventos-field mega-eventos-field--wide">
                                <label for="mega-eventos-field-street">Dirección *</label>
                                <input id="mega-eventos-field-street" name="street" type="text" required="required"/>
                            </div>
                            <div class="mega-eventos-field">
                                <label for="mega-eventos-field-plate">Placa *</label>
                                <input id="mega-eventos-field-plate" name="license_plate" type="text" class="js-mega-eventos-uppercase" required="required"/>
                            </div>
                            <div class="mega-eventos-field">
                                <label for="mega-eventos-field-vehicle">Marca y modelo *</label>
                                <input id="mega-eventos-field-vehicle" name="vehicle_info" type="text" class="js-mega-eventos-uppercase" required="required"/>
                            </div>

                            <label class="mega-eventos-check">
                                <input type="checkbox" id="mega-eventos-field-accept" required="required"/>
                                <span>
                                    Autorizo el tratamiento de mis datos personales y uso de imagen por parte de CENTRO DE SERVICIO AUTOMOTRIZ MEGA S.A.S., conforme a la
                                    Política HABEAS-DATA
                                </span>
                            </label>

                            <div class="mega-eventos-modal__actions">
                                <button type="submit" class="mega-eventos-modal__submit" id="mega-eventos-modal-submit">Inscribirme</button>
                                <button type="button" class="mega-eventos-modal__cancel" id="mega-eventos-modal-cancel">Cancelar</button>
                            </div>
                        </form>

                        <div id="mega-eventos-modal-success" class="mega-eventos-modal__success" hidden="hidden">
                            <div class="mega-eventos-modal__success-icon">&#10003;</div>
                            <h3 class="mega-eventos-modal__success-title">¡Ya aseguraste tu bono!</h3>
                            <p class="mega-eventos-modal__success-code">Tu código es <strong id="mega-eventos-success-code"></strong></p>
                            <p class="mega-eventos-modal__success-text">
                                Por favor agenda tu cita con un asesor de Mega Tecnicentro para hacer válido tu beneficio.
                            </p>
                            <button type="button" class="mega-eventos-modal__submit" id="mega-eventos-modal-success-close">Cerrar</button>
                        </div>
                    </div>
                </div>

                <script type="text/javascript">
                    //<![CDATA[
                    document.addEventListener('DOMContentLoaded', function () {
                        var overlay = document.getElementById('mega-eventos-modal-overlay');
                        var form = document.getElementById('mega-eventos-modal-form');
                        var alertBox = document.getElementById('mega-eventos-modal-alert');
                        var submitButton = document.getElementById('mega-eventos-modal-submit');
                        var serviceField = document.getElementById('mega-eventos-field-service');
                        var benefitLabel = document.getElementById('mega-eventos-modal-benefit');
                        var acceptField = document.getElementById('mega-eventos-field-accept');
                        var successView = document.getElementById('mega-eventos-modal-success');
                        var successCode = document.getElementById('mega-eventos-success-code');
                        var successCloseButton = document.getElementById('mega-eventos-modal-success-close');

                        function updateSubmitState() {
                            submitButton.disabled = !form.checkValidity();
                        }

                        function openModal(serviceValue, label) {
                            form.reset();
                            form.hidden = false;
                            form.style.display = '';
                            successView.hidden = true;
                            serviceField.value = serviceValue;
                            benefitLabel.textContent = label;
                            alertBox.hidden = true;
                            alertBox.className = 'mega-eventos-modal__alert';
                            submitButton.textContent = 'Inscribirme';
                            updateSubmitState();
                            overlay.hidden = false;
                            document.body.style.overflow = 'hidden';
                        }

                        function closeModal() {
                            overlay.hidden = true;
                            document.body.style.overflow = '';
                        }

                        form.addEventListener('input', updateSubmitState);
                        form.addEventListener('change', updateSubmitState);
                        successCloseButton.addEventListener('click', closeModal);

                        form.querySelectorAll('.js-mega-eventos-uppercase').forEach(function (input) {
                            input.addEventListener('input', function () {
                                var selectionStart = input.selectionStart;
                                var selectionEnd = input.selectionEnd;
                                input.value = input.value.toUpperCase();
                                input.setSelectionRange(selectionStart, selectionEnd);
                            });
                        });

                        document.querySelectorAll('.js-mega-eventos-open').forEach(function (button) {
                            button.addEventListener('click', function () {
                                openModal(button.dataset.service, button.dataset.label);
                            });
                        });

                        document.getElementById('mega-eventos-modal-close').addEventListener('click', closeModal);
                        document.getElementById('mega-eventos-modal-cancel').addEventListener('click', closeModal);

                        overlay.addEventListener('click', function (ev) {
                            if (ev.target === ev.currentTarget) {
                                closeModal();
                            }
                        });

                        document.addEventListener('keydown', function (ev) {
                            if (ev.key === 'Escape' && !overlay.hidden) {
                                closeModal();
                            }
                        });

                        form.addEventListener('submit', function (ev) {
                            ev.preventDefault();

                            var payload = {
                                name: form.name.value,
                                vat: form.vat.value,
                                phone: form.phone.value,
                                email: form.email.value,
                                street: form.street.value,
                                license_plate: form.license_plate.value,
                                vehicle_info: form.vehicle_info.value,
                                service_acquired: serviceField.value,
                                accept_data_policy: acceptField.checked,
                            };

                            submitButton.disabled = true;
                            submitButton.textContent = 'Enviando...';

                            fetch('/mega-eventos/inscribirme', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    jsonrpc: '2.0',
                                    method: 'call',
                                    params: payload,
                                }),
                            })
                                .then(function (response) { return response.json(); })
                                .then(function (data) {
                                    var result = (data && data.result) || {};
                                    if (result.success) {
                                        alertBox.hidden = true;
                                        form.hidden = true;
                                        form.style.display = 'none';
                                        form.reset();
                                        successCode.textContent = result.code;
                                        successView.hidden = false;
                                    } else {
                                        var errors = (result.errors && result.errors.length)
                                            ? result.errors
                                            : ['No se pudo completar la inscripción.'];
                                        alertBox.className = 'mega-eventos-modal__alert mega-eventos-modal__alert--error';
                                        alertBox.textContent = errors.join(' ');
                                        alertBox.hidden = false;
                                        submitButton.disabled = false;
                                        submitButton.textContent = 'Inscribirme';
                                    }
                                })
                                .catch(function () {
                                    alertBox.className = 'mega-eventos-modal__alert mega-eventos-modal__alert--error';
                                    alertBox.textContent = 'Ocurrió un error de conexión. Intenta de nuevo.';
                                    alertBox.hidden = false;
                                    submitButton.disabled = false;
                                    submitButton.textContent = 'Inscribirme';
                                });
                        });
                    });
                    //]]>
                </script>
            </body>
        </html>
    </template>
</odoo>
