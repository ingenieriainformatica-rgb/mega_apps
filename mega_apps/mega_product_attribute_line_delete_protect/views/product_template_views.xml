<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Vista heredada única que reemplaza el <list> de attribute_line_ids por DOS
        copias mutuamente excluyentes, filtradas mediante el atributo `groups` del
        arch (con negación `!`), ya que las vistas de extensión (mode='extension')
        no admiten `groups_id` a nivel de registro ir.ui.view (el ORM lo rechaza con
        ValidationError: "Inherited view cannot have 'Groups' define on the record").

        - Copia autorizada (groups="...manager"): idéntica a la vista estándar de
          Odoo (editable, handle de arrastre, botón "Configurar"). Los usuarios del
          grupo conservan el comportamiento normal.
        - Copia no autorizada (groups="!...manager"): de solo lectura. Sin crear,
          sin eliminar, sin arrastrar, sin botón "Configurar", y con los campos
          attribute_id/value_ids en readonly. La protección real ocurre en el
          backend (create/write/unlink); esta vista es defensa en profundidad y UX.
    -->
    <record id="view_product_template_attribute_line_protect_delete"
            model="ir.ui.view">
        <field name="name">product.template.attribute.line.protect.delete</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='attribute_line_ids']/list" position="replace">

                <!-- Usuarios autorizados: comportamiento estándar sin cambios -->
                <list string="Variants" editable="bottom"
                      decoration-info="value_count &lt;= 1"
                      groups="mega_product_attribute_line_delete_protect.group_product_attribute_line_manager">
                    <field name="value_count" column_invisible="True"/>
                    <field name="sequence" widget="handle"/>
                    <field name="attribute_id" readonly="id"/>
                    <field name="value_ids" widget="many2many_tags"
                           options="{'no_create_edit': True, 'color_field': 'color'}"
                           context="{'default_attribute_id': attribute_id, 'show_attribute': False}"/>
                    <button string="Configure" class="float-end btn-secondary"
                            type="object" name="action_open_attribute_values"
                            groups="product.group_product_variant"/>
                </list>

                <!-- Usuarios no autorizados: solo lectura, sin agregar/eliminar/
                     arrastrar/configurar. No se declara editable="bottom" a propósito. -->
                <list string="Variants" create="0" delete="0" no_open="1"
                      decoration-info="value_count &lt;= 1"
                      groups="!mega_product_attribute_line_delete_protect.group_product_attribute_line_manager">
                    <field name="value_count" column_invisible="True"/>
                    <field name="sequence" column_invisible="True"/>
                    <field name="attribute_id" readonly="1" options="{'no_open': True}"/>
                    <field name="value_ids" widget="many2many_tags"
                           options="{'no_create_edit': True, 'color_field': 'color', 'no_open': True}"
                           readonly="1"/>
                </list>

            </xpath>

        </field>
    </record>

</odoo>
