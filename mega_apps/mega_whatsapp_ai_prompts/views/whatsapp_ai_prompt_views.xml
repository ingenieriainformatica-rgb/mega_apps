<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mega_whatsapp_ai_prompt_list" model="ir.ui.view">
        <field name="name">mega.whatsapp.ai.prompt.list</field>
        <field name="model">mega.whatsapp.ai.prompt</field>
        <field name="arch" type="xml">
            <list string="Prompts IA WhatsApp" default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="flow_type"/>
                <field name="prompt_type"/>
                <field name="active"/>
                <field name="company_id"/>
                <field name="team_id"/>
                <field name="version"/>
            </list>
        </field>
    </record>

    <record id="view_mega_whatsapp_ai_prompt_form" model="ir.ui.view">
        <field name="name">mega.whatsapp.ai.prompt.form</field>
        <field name="model">mega.whatsapp.ai.prompt</field>
        <field name="arch" type="xml">
            <form string="Prompt IA WhatsApp">
                <sheet>
                    <group string="Informacion general">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="company_id"/>
                            <field name="team_id"/>
                        </group>
                    </group>
                    <group string="Configuracion del flujo">
                        <group>
                            <field name="flow_type"/>
                            <field name="prompt_type"/>
                        </group>
                    </group>
                    <group string="Prompt">
                        <field name="prompt_text" nolabel="1" placeholder="Escribe aqui el prompt que se usara en una fase posterior."/>
                    </group>
                    <group string="Horarios">
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                        <group>
                            <field name="weekdays" placeholder="Ejemplo: 0,1,2,3,4,5"/>
                        </group>
                    </group>
                    <group string="Notas internas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mega_whatsapp_ai_prompt_search" model="ir.ui.view">
        <field name="name">mega.whatsapp.ai.prompt.search</field>
        <field name="model">mega.whatsapp.ai.prompt</field>
        <field name="arch" type="xml">
            <search string="Prompts IA WhatsApp">
                <field name="name"/>
                <field name="code"/>
                <field name="flow_type"/>
                <field name="prompt_type"/>
                <field name="company_id"/>
                <field name="team_id"/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Flujo simple" name="flow_simple" domain="[('flow_type', '=', 'simple')]"/>
                <filter string="Flujo avanzado" name="flow_advanced" domain="[('flow_type', '=', 'advanced')]"/>
                <separator/>
                <filter string="Prompt principal" name="prompt_main" domain="[('prompt_type', '=', 'main')]"/>
                <filter string="Fuera de horario" name="prompt_after_hours" domain="[('prompt_type', '=', 'after_hours')]"/>
                <filter string="Multimedia" name="prompt_multimedia" domain="[('prompt_type', '=', 'multimedia')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Por equipo de ventas" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Por compania" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Tipo de flujo" name="group_flow_type" context="{'group_by': 'flow_type'}"/>
                    <filter string="Tipo de prompt" name="group_prompt_type" context="{'group_by': 'prompt_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mega_whatsapp_ai_prompt" model="ir.actions.act_window">
        <field name="name">Prompts IA</field>
        <field name="res_model">mega.whatsapp.ai.prompt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mega_whatsapp_ai_prompt_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
