<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_merge_detect_wizard_form" model="ir.ui.view">
        <field name="name">partner.merge.detect.wizard.form</field>
        <field name="model">partner.merge.detect.wizard</field>
        <field name="arch" type="xml">
            <form string="Detectar contactos duplicados">
                <group invisible="result_message">
                    <div class="alert alert-info" role="alert">
                        Esto solo DETECTA duplicados y crea propuestas para revision. No fusiona ni modifica
                        ningun contacto.
                    </div>
                    <field name="run_phase1_vat"/>
                    <field name="run_phase2_name"/>
                </group>
                <group invisible="not result_message">
                    <field name="result_message" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_detect" type="object" string="Detectar duplicados"
                            class="btn-primary" invisible="result_message"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_merge_detect_wizard" model="ir.actions.act_window">
        <field name="name">Detectar Duplicados</field>
        <field name="res_model">partner.merge.detect.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
