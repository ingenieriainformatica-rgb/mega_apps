<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista del wizard -->
    <record id="view_contact_cleanup_wizard_form" model="ir.ui.view">
        <field name="name">contact.cleanup.wizard.form</field>
        <field name="model">contact.menu.wizard</field>
        <field name="arch" type="xml">
            <form string="Limpieza de contactos">
                <sheet>

                    <!-- ALERTA -->
                    <group>
                        <div class="alert alert-warning" role="alert" style="margin-bottom: 16px;">
                            <strong>Advertencia</strong>
                            <br/>
                            Esta acción eliminará de forma permanente contactos considerados como registros sin uso.
                            Antes de continuar, asegúrate de contar con un respaldo de la base de datos.
                        </div>
                    </group>

                    <!-- FILTROS -->
                    <group string="Filtros de ejecución" col="2">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="limit_records"/>
                    </group>

                    <!-- BOTÓN RECÁLCULO -->
                    <group>
                        <button name="action_refresh_candidate_count" type="object" string="Recalcular candidatos" class="btn-secondary"/>
                    </group>

                    <!-- RESUMEN -->
                    <group string="Resumen previo" col="2">
                        <label for="candidate_count" string="Contactos candidatos"/>
                        <field name="candidate_count" readonly="1"/>
                    </group>

                    <!-- MENSAJE COMPUTADO -->
                    <group>
                        <field name="warning_message" widget="html" readonly="1" nolabel="1"/>
                    </group>

                    <!-- DESCRIPCIÓN -->
                    <group string="Criterios de limpieza">
                        <div>
                            <ul style="margin: 0; padding-left: 18px;">
                                <li>Se eliminarán únicamente contactos sin relaciones funcionales.</li>
                                <li>No se eliminarán contactos con usuario asociado.</li>
                                <li>No se eliminarán contactos asociados a empleados.</li>
                                <li>No se eliminararán contactos con facturación, compras o ventas.</li>
                                <li>No se eliminararán contactos con leads u oportunidades.</li>
                                <li>No se eliminararán contactos con registros hijos.</li>
                                <li>No se eliminararán contactos asociados a fondo de cesantías.</li>
                                <li>No se eliminararán contactos asociados a EPS.</li>
                            </ul>
                        </div>
                    </group>

                    <!-- MENSAJE FINAL -->
                    <group>
                        <div class="alert alert-danger" role="alert">
                            Esta acción es irreversible. Procede únicamente si estás seguro.
                        </div>
                    </group>

                </sheet>

                <footer>
                    <button name="action_confirm" type="object" string="Limpiar ahora" class="btn btn-danger" icon="fa-trash" confirm="¿Confirmas la limpieza de contactos? Esta acción no se puede deshacer."/>

                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del wizard -->
    <record id="action_contact_cleanup_wizard" model="ir.actions.act_window">
        <field name="name">Limpiar contactos, basura</field>
        <field name="res_model">contact.menu.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
