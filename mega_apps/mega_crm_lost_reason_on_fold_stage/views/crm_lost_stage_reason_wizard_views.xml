<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mega_crm_lost_stage_reason_wizard_view_form" model="ir.ui.view">
        <field name="name">mega.crm.lost.stage.reason.wizard.form</field>
        <field name="model">mega.crm.lost.stage.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrar oportunidad como perdida">
                <field name="lead_id" invisible="1"/>
                <field name="target_stage_id" invisible="1"/>
                <group>
                    <field name="lost_reason_id" options="{'no_create_edit': True}"/>
                    <field name="lost_feedback" placeholder="Describe por qué se cierra la oportunidad."/>
                </group>
                <footer>
                    <button name="action_apply" string="Confirmar cierre" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
