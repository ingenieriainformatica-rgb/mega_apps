<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_tree_inherit_due_date_real_column" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.due.date.real.column</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="invoice_date_due" string="Fecha vencimiento real" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>