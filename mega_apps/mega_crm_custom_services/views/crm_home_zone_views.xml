<odoo>
    <record id="view_crm_home_zone_tree" model="ir.ui.view">
        <field name="name">crm.home.zone.tree</field>
        <field name="model">crm.home.zone</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_crm_home_zone_form" model="ir.ui.view">
        <field name="name">crm.home.zone.form</field>
        <field name="model">crm.home.zone</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_home_zone" model="ir.actions.act_window">
        <field name="name">Zonas de Domicilio</field>
        <field name="res_model">crm.home.zone</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_crm_home_zone"
              name="Zonas de Domicilio"
              parent="mega_crm_custom_services.menu_crm_home_zone_personalized_services"
              action="action_crm_home_zone"
              sequence="51"/>
</odoo>
