<odoo>
    <record id="view_crm_lead_form_inherit_custom_services" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.custom.services</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[.//field[@name='phone']]" position="inside">

                <!-- ====================================================== -->
                <!-- Información del vehículo y batería                    -->
                <!-- ====================================================== -->

                <separator string="Información del vehículo y batería" colspan="2"/>

                <group colspan="2" col="2">

                    <!-- Vehículo -->
                    <group string="Vehículo">
                        <field name="brand_id" string="Marca" options="{'no_create': True, 'no_edit': True}"/>

                        <field name="modelo_id" string="Modelo" options="{'no_create': True, 'no_edit': True}"/>

                        <field name="year_vehicule_id" string="Año" options="{'no_create': True, 'no_edit': True}"/>

                        <field name="license_plate" string="Placa" placeholder="Ej: ABC123"/>
                    </group>

                    <!-- Batería base -->
                    <group string="Batería">
                        <field name="battery_application_id" string="Catálogo MAC" options="{'no_create': True, 'no_edit': True}"/>

                        <field name="customer_leaves_battery" string="¿Cliente deja batería?" widget="boolean_toggle"/>

                        <field name="left_battery_reference" string="Referencia batería dejada" placeholder="Ej: 48IST950MC" invisible="not customer_leaves_battery"/>
                    </group>

                </group>

                <!-- ====================================================== -->
                <!-- Batería vendida / instalada                           -->
                <!-- ====================================================== -->

                <separator string="Batería vendida / instalada" colspan="2"/>

                <group colspan="2" col="6">

                    <!-- Selección comercial -->
                    <group colspan="6">
                        <field name="sold_battery_option_id" string="Batería vendida / instalada" domain="[('id', 'in', battery_option_ids)]" options="{'no_create': True, 'no_edit': True}" placeholder="Seleccione la batería vendida"/>

                        <field name="sold_battery_price" string="Precio vendido" required="sold_battery_option_id"/>
                    </group>

                    <!-- Detalle de la batería -->
                    <!-- <group string="Detalle" colspan="2" invisible="not sold_battery_option_id">
                        <field name="sold_battery_application_name" string="Aplicación MAC" readonly="1"/>

                        <field name="sold_battery_reference" string="Referencia vendida" readonly="1"/>

                        <field name="sold_battery_line_name" string="Línea vendida" readonly="1"/>
                    </group> -->

                    <!-- Precios de referencia -->
                    <!-- <group string="Precios de referencia" colspan="2" invisible="not sold_battery_option_id">
                        <field name="sold_battery_suggested_price" string="Precio sugerido" readonly="1"/>

                        <field name="sold_battery_min_price" string="Precio mínimo" readonly="1"/>

                        <field name="sold_battery_max_price" string="Precio máximo" readonly="1"/>

                        <field name="sold_battery_currency_id" invisible="1"/>
                    </group> -->

                </group>

                <!-- ====================================================== -->
                <!-- Baterías sugeridas                                    -->
                <!-- ====================================================== -->

                <group string="Baterías sugeridas" col="1" colspan="2">
                    <field name="battery_option_ids" nolabel="1" readonly="1" colspan="2">
                        <list create="0" delete="0" edit="0">
                            <field name="option_number" string="Opción"/>

                            <field name="application_id" string="Aplicación" readonly="1" options="{'no_create': True, 'no_edit': True}"/>

                            <field name="battery_line" string="Línea"/>

                            <field name="reference" string="Referencia"/>

                            <field name="min_sale_price" string="Precio mínimo" optional="show"/>

                            <field name="sale_price" string="Precio sugerido"/>

                            <field name="max_sale_price" string="Máximo" column_invisible="True"/>

                            <field name="stock_qty" string="Existencias" column_invisible="True"/>

                            <field name="description" string="Descripción" optional="show"/>

                            <field name="currency_id" string="Moneda" optional="hide"/>
                        </list>
                    </field>
                </group>

                <!-- ====================================================== -->
                <!-- Información del servicio                              -->
                <!-- ====================================================== -->

                <separator string="Información del servicio" colspan="2"/>

                <group colspan="2" col="2">
                    <group string="Servicio">
                        <field name="tipo_servicio_id" string="Tipo de servicio" options="{'no_create': True, 'no_edit': True}"/>

                        <field name="zona_domicilio_id" string="Zona de domicilio" options="{'no_create': True, 'no_edit': True}"/>
                    </group>

                    <group string="Dirección">
                        <field name="service_address" string="Dirección del servicio" placeholder="Dirección donde se prestará el servicio"/>
                    </group>
                </group>

            </xpath>

        </field>
    </record>
</odoo>
