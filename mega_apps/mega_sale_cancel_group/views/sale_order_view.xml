<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_order_form_cancel_group_restrict" model="ir.ui.view">
      <field name="name">sale.order.form.cancel.group.restrict</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">

        <!-- Restringir botón Cancelar a un grupo -->
        <xpath expr="//button[@name='action_cancel']" position="attributes">
          <attribute name="groups">mega_sale_cancel_group.group_sale_can_cancel_orders</attribute>
        </xpath>

      </field>
    </record>

  </data>
</odoo>