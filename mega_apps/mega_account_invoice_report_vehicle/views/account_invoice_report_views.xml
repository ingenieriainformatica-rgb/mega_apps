<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Heredamos SOLO la vista de búsqueda -->
    <record id="view_account_invoice_report_search_inherit_vehicle" model="ir.ui.view">
        <field name="name">account.invoice.report.search.inherit.vehicle</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="vehicle" string="Vehículo"/>
            </xpath>
        </field>
    </record>

    <record id="mega_account_invoice_report_view_tree_vehicle" model="ir.ui.view">
        <field name="name">account.invoice.report.tree.inherit.vehicle</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.account_invoice_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='partner_id']" position="after">
                <field name="vehicle" optional="show" string="Vehículo"/>
            </xpath>
        </field>
    </record>

</odoo>