<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="report_saleorder_document_prefactura" inherit_id="sale.report_saleorder_document">

    <!-- 1) Título Prefactura -->
    <xpath expr="//t[@t-set='layout_document_title']" position="replace">
      <t t-set="layout_document_title">
        <span>Prefactura # </span>
        <span t-field="doc.name">SO0000</span>
      </t>
    </xpath>

    <xpath expr="(//div[@class='page']//div[@class='oe_structure'])[last()]" position="before">
        <div class="mt-5" style="page-break-inside: avoid;">
            <div class="row">
                <div class="col-12 text-end">
                    <div class="d-inline-block px-5 py-4 text-center">
                    <strong>Firma Aprobado</strong>
                    </div>
                </div>
            </div>
        </div>
    </xpath>

    <!-- Asesor: después del vendedor -->
    <xpath expr="//div[@t-field='doc.user_id']/ancestor::div[1]" position="after">
      <div t-if="doc.advisor_id" class="col">
        <strong>Asesor</strong>
        <div t-field="doc.advisor_id"/>
      </div>
    </xpath>

  </template>

</odoo>
