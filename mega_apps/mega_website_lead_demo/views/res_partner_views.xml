<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_web_terms_conditions" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.web.terms.conditions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_terms_conditions.view_partner_form_inherit_terms"/>
        <field name="arch" type="xml">

            <xpath expr="//page[.//field[@name='has_terms_conditions']]/group" position="after">
                <group string="Términos y Condiciones Website">
                    <field name="accept_web_terms_conditions" widget="boolean_toggle" string="Acepto"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
