<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="lead_demo_floating_button_home" inherit_id="website.layout">
        <xpath expr="//body" position="inside">

            <!-- <t t-if="website and website.id == 1 and request and request.httprequest and request.httprequest.path == '/'"> -->
            <t t-if="website and website.id == 1 and request and request.httprequest">

                <!-- CONTENEDOR -->
                <div id="floating-lead-wrapper" class="container-floating-lead">


                    <button type="button" data-bs-toggle="modal" data-bs-target="#leadDemoModal" class="button-green" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
                        <i class="fa fa-whatsapp fa-fa-whatsapp"></i>
                    </button>


                    <div id="lead-tooltip" class="lead-tooltip-text">
                        ¿Interesado en un servicio?
                    </div>

                </div>

                <!-- MODAL -->
                <div class="modal fade lead-demo-modal" id="leadDemoModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="leadDemoModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content lead-demo-modal-content">

                            <!-- Header -->
                            <div class="lead-demo-modal-header">

                                <div class="lead-demo-header-main">
                                    <img src="/mega_website_lead_demo/static/description/icon.png" alt="Logo" class="lead-demo-logo"/>

                                    <div class="lead-demo-header-text">
                                        <h4 id="leadDemoModalLabel" class="lead-demo-modal-title">
                                            Solicita tu servicio
                                        </h4>

                                        <div class="lead-demo-header-meta">
                                            <small class="lead-demo-modal-subtitle">
                                                Continuamos por WhatsApp
                                            </small>

                                            <span class="lead-demo-required-badge">
                                                * Campos obligatorios
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <button type="button" class="btn-close lead-demo-close-btn" data-bs-dismiss="modal" aria-label="Cerrar"/>
                            </div>

                            <!-- Body -->
                            <div class="modal-body lead-demo-modal-body">
                                <form id="leadDemoForm">

                                    <div class="row g-3">
                                        <div class="col-12 col-md-6">
                                            <input type="text" name="invoice_name" class="form-control lead-demo-input" placeholder="Nombre completo *" required="required"/>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <input type="text" name="vat" class="form-control lead-demo-input" placeholder="Cédula o NIT *" required="required"/>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <input type="text" name="phone" class="form-control lead-demo-input" placeholder="Teléfono *" required="required"/>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <input type="email" name="email" class="form-control lead-demo-input" placeholder="Correo electrónico *" required="required"/>
                                        </div>

                                        <div class="col-12">
                                            <input type="text" name="street" class="form-control lead-demo-input" placeholder="Dirección"/>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <select id="brand_id" name="brand_id" class="form-select lead-demo-input">
                                                <option value="">Seleccione una marca...</option>
                                            </select>
                                            <input type="hidden" id="brand_name" name="brand_name"/>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <select id="model_id" name="model_id" class="form-select lead-demo-input">
                                                <option value="">Seleccione un modelo...</option>
                                            </select>
                                            <input type="hidden" id="model_name" name="model_name"/>
                                        </div>

                                        <div class="col-12">
                                            <input type="text" name="license_plate" class="form-control lead-demo-input" placeholder="Placa *" required="required"/>
                                        </div>
                                    </div>

                                    <div class="lead-demo-check-wrap mt-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="accept_terms" name="accept_terms" value="1" required="required"/>
                                            <label class="form-check-label lead-demo-check-label" for="accept_terms">
                                                Acepto los términos y condiciones y el tratamiento de mis datos personales
                                                <span class="lead-demo-required">*</span>
                                            </label>
                                        </div>
                                    </div>

                                    <input type="hidden" name="page_url" t-att-value="request.httprequest.path"/>
                                    <input type="hidden" name="website_id" t-att-value="website.id"/>
                                    <input type="hidden" name="website_name" t-att-value="website.name"/>

                                    <div id="leadDemoMessage" class="alert d-none mt-3"></div>

                                    <div class="d-grid mt-4">
                                        <button type="submit" id="leadDemoSubmitBtn" class="btn lead-demo-submit-btn">
                                        Solicitar servicio
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </t>

        </xpath>
    </template>

    <!-- Página de confirmación -->
    <template id="lead_demo_thank_you" name="Lead Demo Thank You">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="alert alert-success">
                    <h4>Lead creado correctamente</h4>
                    <p>Se creó el registro: <strong t-esc="lead_name"/>
                    </p>
                </div>
            </div>
        </t>
    </template>

</odoo>
