<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="lead_demo_floating_button_home" inherit_id="website.layout">
        <xpath expr="//body" position="inside">

            <t t-if="website and website.id == 1 and request and request.httprequest and request.httprequest.path == '/'">

                <!-- CONTENEDOR -->
                <div id="floating-lead-wrapper"
                    style="
                        position: fixed;
                        left: 15px;
                        bottom: 120px;
                        z-index: 1050;
                        display: flex;
                        align-items: center;
                        gap: 12px;
                    ">

                    <!-- BOTÓN VERDE -->
                    <button type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#leadDemoModal"
                            style="
                                width: 60px;
                                height: 60px;
                                border-radius: 50%;
                                border: none;
                                background: #25D366;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                box-shadow: 0 8px 20px rgba(0,0,0,0.25);
                                transition: transform 0.2s ease;
                                flex-shrink: 0;
                            "
                            onmouseover="this.style.transform='scale(1.08)'"
                            onmouseout="this.style.transform='scale(1)'">
                        <i class="fa fa-whatsapp" style="font-size: 26px; color: white;"></i>
                    </button>

                    <!-- TEXTO -->
                    <div id="lead-tooltip"
                        style="
                            background: #1f1f1f;
                            color: #fff;
                            padding: 12px 16px;
                            border-radius: 999px;
                            font-size: 14px;
                            font-weight: 500;
                            box-shadow: 0 6px 16px rgba(0,0,0,0.25);
                            white-space: nowrap;
                            animation: fadeInLeft 0.5s ease;
                        ">
                        ¿Interesado en un servicio?
                    </div>

                </div>

                <!-- MODAL -->
                <div class="modal fade" id="leadDemoModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title">Déjanos tus datos</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                            </div>

                            <div class="modal-body">
                                <form action="/lead_demo/test" method="post">

                                    <!-- Mensaje superior -->
                                    <div class="mb-3 text-end">
                                        <small style="color:#6c757d;">
                                            Los campos con <span style="color:red;">*</span> son obligatorios
                                        </small>
                                    </div>

                                    <!-- Nombre -->
                                    <div class="row mb-3 align-items-center">
                                        <label class="col-4 col-form-label">
                                            Nombre <span style="color:red;">*</span>
                                        </label>
                                        <div class="col-8">
                                            <input type="text" name="invoice_name" class="form-control"
                                                placeholder="Ej: Juan Pérez"
                                                required="required"/>
                                        </div>
                                    </div>

                                    <!-- NIT -->
                                    <div class="row mb-3 align-items-center">
                                        <label class="col-4 col-form-label">
                                            Cédula / NIT <span style="color:red;">*</span>
                                        </label>
                                        <div class="col-8">
                                            <input type="text" name="vat" class="form-control"
                                                placeholder="Ej: 900123456"
                                                required="required"/>
                                        </div>
                                    </div>

                                    <!-- Teléfono -->
                                    <div class="row mb-3 align-items-center">
                                        <label class="col-4 col-form-label">
                                            Teléfono <span style="color:red;">*</span>
                                        </label>
                                        <div class="col-8">
                                            <input type="text" name="phone" class="form-control"
                                                placeholder="Ej: 3001234567"
                                                required="required"/>
                                        </div>
                                    </div>

                                    <!-- Dirección -->
                                    <div class="row mb-3 align-items-center">
                                        <label class="col-4 col-form-label">
                                            Dirección
                                        </label>
                                        <div class="col-8">
                                            <input type="text" name="street" class="form-control"
                                                placeholder="Ej: Calle 10 #20-30"/>
                                        </div>
                                    </div>

                                    <!-- Email -->
                                    <div class="row mb-3 align-items-center">
                                        <label class="col-4 col-form-label">
                                            Correo <span style="color:red;">*</span>
                                        </label>
                                        <div class="col-8">
                                            <input type="email" name="email" class="form-control"
                                                placeholder="Ej: correo@empresa.com"
                                                required="required"/>
                                        </div>
                                    </div>

                                    <!-- Marca -->
                                    <div class="row mb-3 align-items-center">
                                        <label class="col-4 col-form-label">
                                            Marca
                                        </label>
                                        <div class="col-8">
                                            <input type="text" name="brand_brand" class="form-control"
                                                placeholder="Ej: Mazda"/>
                                        </div>
                                    </div>

                                    <!-- Modelo -->
                                    <div class="row mb-3 align-items-center">
                                        <label class="col-4 col-form-label">
                                            Modelo
                                        </label>
                                        <div class="col-8">
                                            <input type="text" name="brand_model" class="form-control"
                                                placeholder="Ej: CX-5 2020"/>
                                        </div>
                                    </div>

                                    <!-- Placa -->
                                    <div class="row mb-3 align-items-center">
                                        <label class="col-4 col-form-label">
                                            Placa <span style="color:red;">*</span>
                                        </label>
                                        <div class="col-8">
                                            <input type="text" name="license_plate" class="form-control"
                                                placeholder="Ej: ABC123"
                                                required="required"/>
                                        </div>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                    type="checkbox"
                                                    id="accept_terms"
                                                    name="accept_terms"
                                                    value="1"
                                                    required="required"/>
                                                <label class="form-check-label" for="accept_terms">
                                                    Acepto los <a href="/terminos-y-condiciones" target="_blank">términos y condiciones</a>
                                                    y el tratamiento de mis datos personales <span style="color:red;">*</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Hidden -->
                                    <input type="hidden" name="page_url" t-att-value="request.httprequest.path"/>
                                    <input type="hidden" name="website_id" t-att-value="website.id"/>
                                    <input type="hidden" name="website_name" t-att-value="website.name"/>

                                    <!-- Botón -->
                                    <div class="d-grid mt-3">
                                        <button type="submit" class="btn btn-success">
                                            Enviar información
                                        </button>
                                    </div>

                                </form>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ANIMACIÓN -->
                <style>
                    @keyframes fadeInLeft {
                        from {
                            opacity: 0;
                            transform: translateX(-20px);
                        }
                        to {
                            opacity: 1;
                            transform: translateX(0);
                        }
                    }
                </style>

            </t>

        </xpath>
    </template>


    <!-- Página de confirmación -->
    <template id="lead_demo_thank_you" name="Lead Demo Thank You">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="alert alert-success">
                    <h4>Lead creado correctamente</h4>
                    <p>Se creó el registro: <strong t-esc="lead_name"/></p>
                </div>
            </div>
        </t>
    </template>

</odoo>