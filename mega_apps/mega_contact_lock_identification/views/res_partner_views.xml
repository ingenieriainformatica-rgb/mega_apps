<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_lock_until_identification" model="ir.ui.view">
        <field name="name">res.partner.form.lock.until.identification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Alertas -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info oe_edit_only" role="alert" invisible="vat">
                    <strong>1.</strong> Ingresa el <strong>NIT</strong> o la <strong>cédula</strong> para habilitar los demás campos del contacto.
                </div>

                <div class="alert alert-info oe_edit_only" role="alert" invisible="not vat or country_id">
                    <strong>2.</strong> Selecciona el <strong>País</strong> para continuar.
                </div>

                <div class="alert alert-info oe_edit_only" role="alert" invisible="not vat or not country_id or state_id">
                    <strong>3.</strong> Selecciona el <strong>Estado</strong> para continuar.
                </div>

                <div class="alert alert-info oe_edit_only" role="alert" invisible="not vat or not country_id or not state_id or city">
                    <strong>4.</strong> Ingresa la <strong>Ciudad</strong> para habilitar el resto de los campos.
                </div>
            </xpath>

            <!-- Ocultar label y bloque de dirección mientras no haya identificación -->
            <xpath expr="//span[@name='address_name']" position="attributes">
                <attribute name="invisible">not vat</attribute>
            </xpath>

            <xpath expr="//div[@class='o_address_format']" position="attributes">
                <attribute name="invisible">not vat</attribute>
            </xpath>

            <!-- Nombre: bloquear mientras no haya identificación -->
            <xpath expr="//field[@id='company']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@id='individual']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="groups">mega_contact_lock_identification.group_contact_company_menu_lock</attribute>
                <attribute name="invisible">is_company</attribute>
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='email']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='title']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='lang']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="readonly">not vat</attribute>
            </xpath>

            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="readonly">not vat or not country_id</attribute>
            </xpath>

        </field>
    </record>

</odoo>
