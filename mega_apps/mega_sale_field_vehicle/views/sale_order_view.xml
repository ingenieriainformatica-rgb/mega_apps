<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_vehicle_required" model="ir.ui.view">
        <field name="name">sale.order.form.vehicle.required</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insertar debajo de advisor_id (Asesor) -->
            <xpath expr="//field[@name='advisor_id']" position="after">
                <field name="vehicle" placeholder="Placa ABC123"/>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_add_placa" model="ir.ui.view">
        <field name="name">sale.order.quotation.tree.add.placa</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">

            <!-- Colocarla después del cliente -->
            <xpath expr="//list//field[@name='partner_id']" position="after">
                <field name="vehicle" string="Vehículo" optional="show"/>
            </xpath>

        </field>
    </record>
</odoo>
